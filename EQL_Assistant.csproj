<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For the system-tray NotifyIcon (System.Windows.Forms). WPF types are used
         fully-qualified to avoid clashes with WinForms' Application/MessageBox. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Product name is "EQL Assistant" (exe: EQL_Assistant.exe). Code namespaces
         stay EQLOverlay — internal only, renaming them buys nothing. -->
    <AssemblyName>EQL_Assistant</AssemblyName>
    <RootNamespace>EQLOverlay</RootNamespace>
    <Product>EQL Assistant</Product>
    <AssemblyTitle>EQL Assistant</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\eqloverlay.ico</ApplicationIcon>
    <!-- Bump this for each standalone build; it stamps the exe and shows in the toolbar. -->
    <Version>2.30.0</Version>
    <!-- WFO0003: WinForms wants DPI set via API, but this is a WPF app whose DPI is
         correctly declared in app.manifest (PerMonitorV2). Safe to ignore. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is enabled only for the tray NotifyIcon (referenced fully-qualified).
         Drop its implicit global usings so they don't clash with WPF's Brush/Application. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also expose the icon as a WPF resource so windows can use it via pack URI. -->
    <Resource Include="assets\eqloverlay.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship a reference copy of the default config next to the exe.
         The app actually reads/writes config in %APPDATA%\EQL_Assistant. -->
    <None Update="config\config.default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Prebaked spell library (converted from jmoyers/everquest-companion, MIT).
         Embedded so a lone copied exe still carries it; the on-disk copy (if
         present next to the exe) wins, so users can tweak it. -->
    <None Update="data\spell-library.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="data\spell-library.json" />
    <!-- Plane of Sky Test quests (same source/license as the spell library). -->
    <None Update="data\sky-quests.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="data\sky-quests.json" />
    <!-- Focus-effect families (eqlwiki Category:Focus_Effects + Companion items.json, MIT). -->
    <None Update="data\focus-effects.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="data\focus-effects.json" />
    <!-- Item stats for the character sheet (same source/license). -->
    <None Update="data\item-stats.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="data\item-stats.json" />
    <!-- Planar class armor sets (eqlwiki Category:Armor_Sets scrape). -->
    <None Update="data\armor-sets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="data\armor-sets.json" />
    <!-- The wiki's 40×40 item icons (eqlwiki/p99 art shipped by Companion),
         keyed item-<iconId>.png — WPF resources, looked up via pack URI. -->
    <Resource Include="data\item-icons\*.png" />
  </ItemGroup>

</Project>
