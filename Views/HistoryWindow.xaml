<Window x:Class="EQLOverlay.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:EQLOverlay.Views"
        Title="EQL Assistant — Fight History"
        Width="940" Height="620"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="StatRowTemplate">
                <StackPanel Margin="0,1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}"
                                   Foreground="{StaticResource Brush.Text}"
                                   FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.TextFaint}" FontSize="10"
                               Margin="8,0,0,1" TextWrapping="Wrap"
                               Visibility="{Binding DetailVisibility}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Foreground="#7F93AD" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="A fight lands here ~10 seconds after combat goes quiet (the session keeps the last 50). Select one for details — the breakdown, the timeline and ⚡ Analyse. Ctrl-click more to compare side by side. ★ Keep saves a fight permanently, so you can compare this week's kill against last week's."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="★ Keep fight" Click="Keep_Click" Style="{StaticResource ToolBtn}"
                            AutomationProperties.AutomationId="HistoryKeepBtn"
                            ToolTip="Save the selected fight(s) permanently (survives restarts)"/>
                    <Button Content="Remove fight" Click="Remove_Click" Style="{StaticResource ToolBtn}"
                            ToolTip="Stop keeping the selected saved fight(s)"/>
                </StackPanel>
                <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Visibility="Collapsed"
                           Foreground="#7F93AD" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,6"
                           Text="No fights yet — right after launch the app is still catching up today's log (a few seconds); they appear here as it finishes."/>
                <!-- Grouped by day — Standard virtualization, NEVER Recycling:
                     recycling silently skips rows in grouped lists. -->
                <ListBox x:Name="FightsList"
                         SelectionMode="Extended" FontSize="12"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.VirtualizationMode="Standard"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="#7F93AD"
                                               FontSize="10" FontWeight="SemiBold"
                                               Margin="2,8,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <!-- Ellipsis, not a hard clip: a row cut mid-glyph leaves a
                         one-pixel sliver that reads like a hidden control. -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Tip}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Details, Johan's three bands: highlights + the two timelines
                 (the report) up top, per-ability tables below. -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <v:TimelineView x:Name="TimelinePane" Margin="0,0,0,12"
                                    Visibility="Collapsed"/>

                    <!-- One full-width row per selected fight: the sections flow
                         side by side across the window instead of stacking in a
                         240px tower next to dead space. Comparisons stack rows. -->
                    <ItemsControl x:Name="ColumnsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="10" CornerRadius="8"
                                        Background="#1B2130" BorderBrush="#3A4560" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,2" Visibility="{Binding HeaderVisibility}">
                                            <Run Text="{Binding Title, Mode=OneWay}" Foreground="#C9D4E3"
                                                 FontWeight="Bold" FontSize="13"/>
                                            <Run Text="   "/>
                                            <Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="#7F93AD"
                                                 FontSize="11"/>
                                        </TextBlock>

                                        <!-- Fight context and the taken totals live in the
                                             report's chips and tiles — the cards stay pure
                                             per-ability tables. -->
                                        <WrapPanel>
                                            <!-- ==== DAMAGE DEALT ==== -->
                                            <Border Style="{StaticResource SectionCard}" Width="230"
                                                    Margin="0,4,10,0" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock Text="Damage dealt" Foreground="#FFD54F"
                                                               Style="{StaticResource SectionHeader}"/>
                                                    <ItemsControl ItemsSource="{Binding DamageRows}"
                                                                  ItemTemplate="{StaticResource StatRowTemplate}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- ==== YOUR / PET ABILITIES ==== -->
                                            <Border Style="{StaticResource SectionCard}" Width="230"
                                                    Margin="0,4,10,0" VerticalAlignment="Top"
                                                    Visibility="{Binding SelfSectionVisibility}">
                                                <StackPanel>
                                                    <TextBlock Text="Your abilities" Foreground="#FFD54F"
                                                               Style="{StaticResource SectionHeader}"/>
                                                    <ItemsControl ItemsSource="{Binding SelfAbilityRows}"
                                                                  ItemTemplate="{StaticResource StatRowTemplate}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource SectionCard}" Width="230"
                                                    Margin="0,4,10,0" VerticalAlignment="Top"
                                                    Visibility="{Binding PetSectionVisibility}">
                                                <StackPanel>
                                                    <TextBlock Text="Pet abilities" Foreground="#D7CCC8"
                                                               Style="{StaticResource SectionHeader}"/>
                                                    <ItemsControl ItemsSource="{Binding PetAbilityRows}"
                                                                  ItemTemplate="{StaticResource StatRowTemplate}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- ==== WHAT HIT YOU ==== -->
                                            <Border Style="{StaticResource SectionCard}" Width="230"
                                                    Margin="0,4,10,0" VerticalAlignment="Top"
                                                    Visibility="{Binding TakenSectionVisibility}">
                                                <StackPanel>
                                                    <TextBlock Text="What hit you" Foreground="#FF8A80"
                                                               Style="{StaticResource SectionHeader}"/>
                                                    <ItemsControl ItemsSource="{Binding TakenAbilityRows}"
                                                                  ItemTemplate="{StaticResource StatRowTemplate}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- ==== HEALING ==== -->
                                            <Border Style="{StaticResource SectionCard}" Width="230"
                                                    Margin="0,4,10,0" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock Text="Healing" Foreground="#81C784"
                                                               Style="{StaticResource SectionHeader}"/>
                                                    <ItemsControl ItemsSource="{Binding HealingRows}"
                                                                  ItemTemplate="{StaticResource StatRowTemplate}"/>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
