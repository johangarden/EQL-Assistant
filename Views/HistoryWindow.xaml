<Window x:Class="EQLOverlay.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Fight History"
        Width="820" Height="520"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="StatRowTemplate">
                <StackPanel Margin="0,1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value}"
                                   Foreground="{StaticResource Brush.Text}"
                                   FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.TextFaint}" FontSize="10"
                               Margin="8,0,0,1" TextWrapping="Wrap"
                               Visibility="{Binding DetailVisibility}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Foreground="#7F93AD" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="A fight lands here ~10 seconds after combat goes quiet (the session keeps the last 50). Select one for details — Ctrl-click more to compare side by side. ★ Keep saves a fight permanently, so you can compare this week's kill against last week's."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="★ Keep" Click="Keep_Click" Style="{StaticResource ToolBtn}"
                            AutomationProperties.AutomationId="HistoryKeepBtn"
                            ToolTip="Save the selected fight(s) permanently (survives restarts)"/>
                    <Button Content="Remove kept" Click="Remove_Click" Style="{StaticResource ToolBtn}"
                            ToolTip="Stop keeping the selected saved fight(s)"/>
                    <Button Content="Raid kills" Click="Raids_Click" Style="{StaticResource ToolBtn}"
                            AutomationProperties.AutomationId="HistoryRaidsBtn"
                            ToolTip="Raid target progression — kill counts per zone"/>
                    <Button Content="Loot" Click="Loot_Click" Style="{StaticResource ToolBtn}"
                            AutomationProperties.AutomationId="HistoryLootBtn"
                            ToolTip="Loot history — upgrades, kept items and vendored drops"/>
                    <Button Content="Sky" Click="Sky_Click" Style="{StaticResource ToolBtn}"
                            AutomationProperties.AutomationId="HistorySkyBtn"
                            ToolTip="Plane of Sky quest tracker — have/need per Test quest"/>
                    <Button Content="Timeline" Click="Timeline_Click" Style="{StaticResource ToolBtn}"
                            AutomationProperties.AutomationId="HistoryTimelineBtn"
                            ToolTip="Second-by-second timeline of the selected fight — a lane per ability with every hit, miss, crit and resist"/>
                </StackPanel>
                <ListBox x:Name="FightsList"
                         SelectionMode="Extended" FontSize="12"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>

            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ColumnsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="240" Margin="0,0,10,0" Padding="10" CornerRadius="8"
                                    Background="#1B2130" BorderBrush="#3A4560" BorderThickness="1"
                                    VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="#C9D4E3" FontWeight="Bold"
                                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="#7F93AD" FontSize="11"
                                               Margin="0,1,0,0" TextWrapping="Wrap"/>

                                    <!-- ============ DAMAGE DEALT ============ -->
                                    <Border Style="{StaticResource SectionCard}">
                                        <StackPanel>
                                            <TextBlock Text="Damage dealt" Foreground="#FFD54F"
                                                       Style="{StaticResource SectionHeader}"/>
                                            <ItemsControl ItemsSource="{Binding DamageRows}"
                                                          ItemTemplate="{StaticResource StatRowTemplate}"/>

                                            <StackPanel Visibility="{Binding SelfSectionVisibility}">
                                                <TextBlock Text="Your abilities" Style="{StaticResource SubLabel}"/>
                                                <ItemsControl ItemsSource="{Binding SelfAbilityRows}" Margin="8,0,0,0"
                                                              ItemTemplate="{StaticResource StatRowTemplate}"/>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding PetSectionVisibility}">
                                                <TextBlock Text="Pet abilities" Style="{StaticResource SubLabel}"/>
                                                <ItemsControl ItemsSource="{Binding PetAbilityRows}" Margin="8,0,0,0"
                                                              ItemTemplate="{StaticResource StatRowTemplate}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- ============ DAMAGE TAKEN ============ -->
                                    <Border Style="{StaticResource SectionCard}">
                                        <StackPanel>
                                            <TextBlock Text="Damage taken" Foreground="#FF8A80"
                                                       Style="{StaticResource SectionHeader}"/>
                                            <ItemsControl ItemsSource="{Binding TakenRows}"
                                                          ItemTemplate="{StaticResource StatRowTemplate}"/>

                                            <StackPanel Visibility="{Binding TakenSectionVisibility}">
                                                <TextBlock Text="What hit you" Style="{StaticResource SubLabel}"/>
                                                <ItemsControl ItemsSource="{Binding TakenAbilityRows}" Margin="8,0,0,0"
                                                              ItemTemplate="{StaticResource StatRowTemplate}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- ============ HEALING ============ -->
                                    <Border Style="{StaticResource SectionCard}">
                                        <StackPanel>
                                            <TextBlock Text="Healing" Foreground="#81C784"
                                                       Style="{StaticResource SectionHeader}"/>
                                            <ItemsControl ItemsSource="{Binding HealingRows}"
                                                          ItemTemplate="{StaticResource StatRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
