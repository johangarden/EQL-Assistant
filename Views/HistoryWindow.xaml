<Window x:Class="EQLOverlay.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Overlay — Fight History"
        Width="820" Height="520"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#141A24"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5C6B82"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <DataTemplate x:Key="StatRowTemplate">
            <DockPanel Margin="0,1">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Foreground="#DCE6F5"
                           FontSize="11" FontWeight="SemiBold" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Foreground="#7F93AD" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="A fight lands here ~10 seconds after combat goes quiet (the session keeps the last 20). Select one for details — Ctrl-click more to compare side by side. ★ Keep saves a fight permanently, so you can compare this week's kill against last week's."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="★ Keep" Click="Keep_Click" Style="{StaticResource ToolBtn}"
                            AutomationProperties.AutomationId="HistoryKeepBtn"
                            ToolTip="Save the selected fight(s) permanently (survives restarts)"/>
                    <Button Content="Remove kept" Click="Remove_Click" Style="{StaticResource ToolBtn}"
                            ToolTip="Stop keeping the selected saved fight(s)"/>
                </StackPanel>
                <ListBox x:Name="FightsList"
                         Background="#1B2130" Foreground="#DCE6F5" BorderBrush="#3A4560" BorderThickness="1"
                         SelectionMode="Extended" FontSize="12"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>

            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ColumnsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="228" Margin="0,0,10,0" Padding="10" CornerRadius="8"
                                    Background="#1B2130" BorderBrush="#3A4560" BorderThickness="1"
                                    VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="#C9D4E3" FontWeight="Bold"
                                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="#7F93AD" FontSize="11"
                                               Margin="0,1,0,0"/>

                                    <TextBlock Text="DAMAGE" Style="{StaticResource SectionLabel}"/>
                                    <ItemsControl ItemsSource="{Binding DamageRows}"
                                                  ItemTemplate="{StaticResource StatRowTemplate}"/>

                                    <TextBlock Text="HEALING" Style="{StaticResource SectionLabel}"/>
                                    <ItemsControl ItemsSource="{Binding HealingRows}"
                                                  ItemTemplate="{StaticResource StatRowTemplate}"/>

                                    <TextBlock Text="INCOMING" Style="{StaticResource SectionLabel}"/>
                                    <ItemsControl ItemsSource="{Binding IncomingRows}"
                                                  ItemTemplate="{StaticResource StatRowTemplate}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
