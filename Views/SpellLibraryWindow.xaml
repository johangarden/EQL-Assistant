<Window x:Class="EQLOverlay.Views.SpellLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Spell Library"
        Width="760" Height="600"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#141A24"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCE6F5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#232B3D"/>
            <Setter Property="Foreground" Value="#DCE6F5"/>
            <Setter Property="BorderBrush" Value="#3A4560"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="CaretBrush" Value="#DCE6F5"/>
            <Setter Property="SelectionBrush" Value="#2E6FB0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DCE6F5"/>
            <Setter Property="Background" Value="#2A3346"/>
            <Setter Property="BorderBrush" Value="#4A5A78"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3C4A63"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22608F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#7F93AD" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="Add from the spell library" FontSize="16" FontWeight="Bold" Foreground="White"/>
            </DockPanel>
            <TextBlock Foreground="#7F93AD" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"
                       Text="Real cast and wear-off messages with class levels and buff durations — one click adds a ready-made trigger to the current loadout (editable afterwards like any trigger)."/>

            <DockPanel Margin="0,0,0,8">
                <ComboBox x:Name="ClassBox" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                          SelectionChanged="Filters_Changed"/>
                <ComboBox x:Name="FilterBox" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0"
                          SelectionChanged="Filters_Changed" SelectedValuePath="Tag">
                    <ComboBoxItem Content="All spells" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="Seen in your log" Tag="seen"/>
                    <ComboBoxItem Content="Buffs" Tag="Buff"/>
                    <ComboBoxItem Content="Debuffs" Tag="Debuff"/>
                    <ComboBoxItem Content="Illusions" Tag="Illusion"/>
                </ComboBox>
                <TextBox x:Name="SearchBox" TextChanged="Filters_Changed"
                         AutomationProperties.AutomationId="LibrarySearchBox"
                         ToolTip="Search name, message text or spell type"/>
            </DockPanel>
        </StackPanel>

        <ListBox x:Name="ResultsList"
                 Background="#1B2130" Foreground="#DCE6F5" BorderBrush="#3A4560" BorderThickness="1"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Bar" Margin="0,0,4,0" Click="AddBar_Click"
                                    IsEnabled="{Binding CanBar}"
                                    ToolTip="Countdown bar: starts on the cast message, cleared by the wear-off line, correct duration prefilled"/>
                            <Button Content="Bar + voice" Margin="0,0,4,0" Click="AddBarVoice_Click"
                                    IsEnabled="{Binding CanBar}"
                                    ToolTip="Same bar, plus a spoken warning 20 seconds before it runs out"/>
                            <Button Content="Fade flash" Click="AddFade_Click"
                                    IsEnabled="{Binding CanFade}"
                                    ToolTip="Screen flash the moment the wear-off line appears in the log"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SeenBadge}" Foreground="#FFD54F" FontSize="11"
                                           Margin="6,1,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Foreground="#7F93AD" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
