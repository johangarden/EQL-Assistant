<Window x:Class="EQLOverlay.Views.SpellLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Spell Library"
        Width="820" Height="600"
        MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="8,2"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#7F93AD" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="Spell library" FontSize="16" FontWeight="Bold" Foreground="White"/>
            </DockPanel>
            <TextBlock Foreground="#7F93AD" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"
                       Text="Every spell the duration learner has measured — the estimate the bars use (log = learned from your own cast→fade cycles, db = the library's figure), sample count and spread. Search reaches the WHOLE ~1400-spell library; ＋ adds a ready-made countdown bar trigger (type, color, duration and fade voice prefilled) to the current loadout."/>

            <DockPanel Margin="0,0,0,8">
                <ComboBox x:Name="ClassBox" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                          MinHeight="30" SelectionChanged="Filters_Changed"/>
                <TextBox x:Name="SearchBox" TextChanged="Filters_Changed"
                         AutomationProperties.AutomationId="LibrarySearchBox"
                         ToolTip="Search the whole spell library — matches without samples show with the library's duration"/>
            </DockPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid x:Name="DurTableHost" VerticalAlignment="Top"/>
        </ScrollViewer>
    </DockPanel>
</Window>
