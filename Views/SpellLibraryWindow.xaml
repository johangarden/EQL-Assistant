<Window x:Class="EQLOverlay.Views.SpellLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Spell Library"
        Width="760" Height="600"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="8,3"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#7F93AD" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="Add from the spell library" FontSize="16" FontWeight="Bold" Foreground="White"/>
            </DockPanel>
            <TextBlock Foreground="#7F93AD" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"
                       Text="Real cast and wear-off messages with class levels and buff durations — one click adds a ready-made trigger to the current loadout (editable afterwards like any trigger)."/>

            <DockPanel Margin="0,0,0,8">
                <ComboBox x:Name="ClassBox" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                          MinHeight="30" SelectionChanged="Filters_Changed"/>
                <ComboBox x:Name="FilterBox" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0"
                          MinHeight="30" SelectionChanged="Filters_Changed" SelectedValuePath="Tag">
                    <ComboBoxItem Content="All spells" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="Seen in your log" Tag="seen"/>
                    <ComboBoxItem Content="Buffs" Tag="Buff"/>
                    <ComboBoxItem Content="Debuffs" Tag="Debuff"/>
                    <ComboBoxItem Content="Illusions" Tag="Illusion"/>
                </ComboBox>
                <TextBox x:Name="SearchBox" TextChanged="Filters_Changed"
                         AutomationProperties.AutomationId="LibrarySearchBox"
                         ToolTip="Search name, message text or spell type"/>
            </DockPanel>
        </StackPanel>

        <ListBox x:Name="ResultsList"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Bar" Margin="0,0,4,0" Click="AddBar_Click"
                                    IsEnabled="{Binding CanBar}"
                                    ToolTip="Countdown bar: starts on the cast message, cleared by the wear-off line, correct duration prefilled"/>
                            <Button Content="Bar + voice" Margin="0,0,4,0" Click="AddBarVoice_Click"
                                    IsEnabled="{Binding CanBar}"
                                    ToolTip="Same bar, plus a spoken warning 20 seconds before it runs out"/>
                            <Button Content="Fade flash" Click="AddFade_Click"
                                    IsEnabled="{Binding CanFade}"
                                    ToolTip="Screen flash the moment the wear-off line appears in the log"/>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SeenBadge}" Foreground="#FFD54F" FontSize="11"
                                           Margin="6,1,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Foreground="#7F93AD" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
