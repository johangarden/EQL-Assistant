<Window x:Class="EQLOverlay.Views.SpellLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Spell Library"
        Width="760" Height="600"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="8,3"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#7F93AD" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="Add from the spell library" FontSize="16" FontWeight="Bold" Foreground="White"/>
            </DockPanel>
            <TextBlock Foreground="#7F93AD" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"
                       Text="One click adds a ready-made countdown bar with a spoken fade warning to the current loadout — type, color, duration and voice all prefilled, all editable on the trigger afterwards."/>

            <DockPanel Margin="0,0,0,8">
                <ComboBox x:Name="ClassBox" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                          MinHeight="30" SelectionChanged="Filters_Changed"/>
                <ComboBox x:Name="FilterBox" DockPanel.Dock="Right" Width="150" Margin="8,0,0,0"
                          MinHeight="30" SelectionChanged="Filters_Changed" SelectedValuePath="Tag">
                    <ComboBoxItem Content="All spells" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="Seen in your log" Tag="seen"/>
                    <ComboBoxItem Content="Buffs" Tag="Buff"/>
                    <ComboBoxItem Content="Debuffs" Tag="Debuff"/>
                    <ComboBoxItem Content="Illusions" Tag="Illusion"/>
                </ComboBox>
                <TextBox x:Name="SearchBox" TextChanged="Filters_Changed"
                         AutomationProperties.AutomationId="LibrarySearchBox"
                         ToolTip="Search name, message text or spell type"/>
            </DockPanel>
        </StackPanel>

        <!-- Recycling + IsVirtualizingWhenGrouping is a known WPF combo that
             silently skips rows while scrolling grouped lists (Sloths Healing
             vanished from the SHM listing) — Standard mode renders reliably
             and 250 capped rows cost nothing. -->
        <ListBox x:Name="ResultsList"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.VirtualizationMode="Standard"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,10,6,3">
                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold"
                                           Foreground="#5C6B82" VerticalAlignment="Center"/>
                                <Border Height="1" Background="#2A3347"
                                        Margin="8,1,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,3">
                        <Button DockPanel.Dock="Right" Content="＋ Add" VerticalAlignment="Center"
                                Click="Add_Click" IsEnabled="{Binding CanBar}"
                                ToolTip="Countdown bar with the right type, color and duration, plus a spoken fade warning — toggle the voice off on the trigger if you don't want it"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SeenBadge}" Foreground="#FFD54F" FontSize="11"
                                           Margin="6,1,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Foreground="#7F93AD" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
