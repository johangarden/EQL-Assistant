<Window x:Class="EQLOverlay.Views.TradeskillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Flat header buttons — the panel is interactive (no-activate),
             like the DPS meter; window-local styles, never stock chrome. -->
        <Style x:Key="Flat" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#C9D4E3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3350"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Tradeskill helper (owner, 21 Sep): pick a skill, get to work. The
         card shows the guide step you are on, its ingredients with where
         they come from, the session, and what to move to when the game
         says a recipe went trivial. Header: skill (dropdown) · pill · your
         skill value · close. -->
    <Border x:Name="RootBorder" CornerRadius="8" Padding="10,7,10,9" Background="#E6141A24"
            BorderBrush="#3A4560" BorderThickness="1" Width="332">
        <StackPanel>
            <DockPanel x:Name="HeaderRow" Margin="0,0,0,6" Background="Transparent" MouseLeftButtonDown="Header_DragMove">
                <Button x:Name="CloseBtn" DockPanel.Dock="Right" Style="{StaticResource Flat}" Click="Close_Click"
                        Foreground="#7F93AD" FontSize="10" Width="18" Height="18" Padding="0" Margin="6,0,0,0"
                        ToolTip="Close the tradeskill helper" Content="✕"/>
                <TextBlock x:Name="ValueText" DockPanel.Dock="Right" FontSize="15" FontWeight="Bold" Foreground="#E8C15A"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <Border x:Name="Pill" DockPanel.Dock="Right" Padding="7,1,7,2" CornerRadius="8" Margin="6,0,0,0"
                        Background="#232B3D" BorderBrush="#3A4560" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock x:Name="PillText" FontSize="10" FontWeight="Bold" Foreground="#C9D4E3"/>
                </Border>
                <Button x:Name="SkillBtn" Style="{StaticResource Flat}" Click="Skill_Click" HorizontalAlignment="Left"
                        ToolTip="Switch to another tradeskill" Padding="3,1,5,1">
                    <TextBlock x:Name="SkillText" FontSize="11" FontWeight="Bold" Foreground="#C9D4E3" Text="BREWING ▼"/>
                </Button>
            </DockPanel>

            <StackPanel x:Name="Body"/>
        </StackPanel>
    </Border>
</Window>
