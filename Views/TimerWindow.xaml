<Window x:Class="EQLOverlay.Views.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Timer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Drag anywhere on the card (buttons handle their own clicks). -->
    <Border x:Name="RootBorder" CornerRadius="10" Padding="10"
            Background="#D6141A24" BorderBrush="#3A4560" BorderThickness="1"
            MouseLeftButtonDown="Card_DragMove">
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <!-- The one mode decision, worn as a labeled pill (a glyph
                     couldn't say "who owns the pie" at a glance). -->
                <Button DockPanel.Dock="Left" x:Name="ModeToggleBtn" Click="OnModeToggle"
                        AutomationProperties.AutomationId="TimerModeBtn"
                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillBorder" CornerRadius="9" Background="#26314A"
                                    BorderBrush="#3A4560" BorderThickness="1" Padding="8,2">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="10"
                                           FontWeight="SemiBold" Foreground="#9FB0C8"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="#33415E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Click="OnAddRespawn"
                        AutomationProperties.AutomationId="TimerAddRespawnBtn"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE710;"
                        ToolTip="Add a respawn from your recent kills"/>
                <TextBlock x:Name="ModeLabel" Text="Timer" Foreground="#C9D4E3" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="6,0,4,0"/>
            </DockPanel>

            <Grid Width="132" Height="132">
                <!-- face -->
                <Ellipse Fill="#66101722" Stroke="#46567A" StrokeThickness="2"/>
                <!-- shrinking red pie (Data set in code) -->
                <Path x:Name="Wedge" Fill="#E53935"/>
                <!-- inner mask so the pie reads as a ring-less disc face + hub -->
                <Ellipse Width="14" Height="14" Fill="#20293A" Stroke="#46567A" StrokeThickness="1"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="TimeText" Text="0:00" Foreground="White" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.9" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- Egg-timer controls: manual mode only. In automatic the pie is
                 the respawns' — there is nothing to set, pause or restart. -->
            <StackPanel x:Name="ManualControls" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,8,0,0" Visibility="Collapsed">
                <Button Style="{StaticResource IconBtn}" Click="OnSet" Margin="0,0,6,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE70F;" ToolTip="Set duration"/>
                <Button x:Name="PlayPauseBtn" Style="{StaticResource IconBtn}" Click="OnPlayPause" Margin="0,0,6,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE768;" ToolTip="Start / resume"/>
                <Button Style="{StaticResource IconBtn}" Click="OnRestart"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE72C;" ToolTip="Restart"/>
            </StackPanel>

            <!-- Other named repops still running (the big watch shows the most recent). -->
            <ItemsControl x:Name="SecondariesControl" Margin="0,8,0,0" MaxWidth="150">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,1">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}"
                                       Foreground="{Binding Foreground}" FontWeight="Bold" FontSize="12"
                                       Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
