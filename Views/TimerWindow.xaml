<Window x:Class="EQLOverlay.Views.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Overlay — Timer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Drag anywhere on the card (buttons handle their own clicks). -->
    <Border x:Name="RootBorder" CornerRadius="10" Padding="10"
            Background="#D6141A24" BorderBrush="#3A4560" BorderThickness="1"
            MouseLeftButtonDown="Card_DragMove">
        <StackPanel>
            <Grid Width="132" Height="132">
                <!-- face -->
                <Ellipse Fill="#66101722" Stroke="#46567A" StrokeThickness="2"/>
                <!-- shrinking red pie (Data set in code) -->
                <Path x:Name="Wedge" Fill="#E53935"/>
                <!-- inner mask so the pie reads as a ring-less disc face + hub -->
                <Ellipse Width="14" Height="14" Fill="#20293A" Stroke="#46567A" StrokeThickness="1"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock x:Name="TimeText" Text="0:00" Foreground="White" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.9" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Style="{StaticResource IconBtn}" Click="OnSet" Margin="0,0,4,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE70F;" ToolTip="Set duration"/>
                <Button Style="{StaticResource IconBtn}" Click="OnPlay" Margin="0,0,4,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE768;" ToolTip="Start / resume"/>
                <Button Style="{StaticResource IconBtn}" Click="OnPause" Margin="0,0,4,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE769;" ToolTip="Pause"/>
                <Button Style="{StaticResource IconBtn}" Click="OnRestart"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE72C;" ToolTip="Restart"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
