<Window x:Class="EQLOverlay.Views.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Timer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Drag anywhere on the card (buttons handle their own clicks). -->
    <Border x:Name="RootBorder" CornerRadius="10" Padding="10"
            Background="#E60F141D" BorderThickness="1.5"
            MouseLeftButtonDown="Card_DragMove">
        <Border.BorderBrush>
            <!-- a whisper of bronze around the card — the ring's metal, echoed -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#8A7448" Offset="0"/>
                <GradientStop Color="#3A2F1C" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <!-- The one mode decision, worn as a labeled pill (a glyph
                     couldn't say "who owns the pie" at a glance). -->
                <Button DockPanel.Dock="Left" x:Name="ModeToggleBtn" Click="OnModeToggle"
                        AutomationProperties.AutomationId="TimerModeBtn"
                        Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PillBorder" CornerRadius="9" Background="#26314A"
                                    BorderBrush="#3A4560" BorderThickness="1" Padding="8,2">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="10"
                                           FontWeight="SemiBold" Foreground="#9FB0C8"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PillBorder" Property="Background" Value="#33415E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Click="OnAddRespawn"
                        AutomationProperties.AutomationId="TimerAddRespawnBtn"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE710;"
                        ToolTip="Add a respawn from your recent kills"/>
                <TextBlock x:Name="ModeLabel" Text="Spawn Timer" Foreground="#E8C15A"
                           FontFamily="Georgia" FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="6,0,4,0">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.8" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
            </DockPanel>

            <!-- The spawn clock: a beveled steel ring of segment blocks that go
                 out as time drains (geometry built in code), gold serif digits. -->
            <Grid Width="140" Height="140">
                <!-- outer metal bevel -->
                <Ellipse>
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#5A6A86" Offset="0"/>
                            <GradientStop Color="#141A26" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.StrokeThickness>5</Ellipse.StrokeThickness>
                </Ellipse>
                <!-- the segment track -->
                <Ellipse Margin="5" Fill="#CC0B0F16"/>
                <Path x:Name="SegmentsDim" Fill="#1B222E"/>
                <Path x:Name="SegmentsLit" Fill="#4CAF50"/>
                <!-- inner face: a dark disc with its own rim -->
                <Ellipse Margin="26">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1D2534" Offset="0"/>
                            <GradientStop Color="#0C1017" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Margin="26" Stroke="#3A4560" StrokeThickness="1.5"/>
                <TextBlock x:Name="TimeText" Text="0:00" Foreground="#E8C15A"
                           FontFamily="Georgia" FontSize="27" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.9" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- Egg-timer controls: manual mode only. In automatic the pie is
                 the respawns' — there is nothing to set, pause or restart. -->
            <StackPanel x:Name="ManualControls" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,8,0,0" Visibility="Collapsed">
                <Button Style="{StaticResource IconBtn}" Click="OnSet" Margin="0,0,6,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE70F;" ToolTip="Set duration"/>
                <Button x:Name="PlayPauseBtn" Style="{StaticResource IconBtn}" Click="OnPlayPause" Margin="0,0,6,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE768;" ToolTip="Start / resume"/>
                <Button Style="{StaticResource IconBtn}" Click="OnRestart"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE72C;" ToolTip="Restart"/>
            </StackPanel>

            <!-- Other named repops still running (the big watch shows the most recent). -->
            <ItemsControl x:Name="SecondariesControl" Margin="0,8,0,0" MaxWidth="150">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,1">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}"
                                       Foreground="{Binding Foreground}" FontWeight="Bold" FontSize="12"
                                       Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
