<Window x:Class="EQLOverlay.Views.EnemyDotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="RootBorder" CornerRadius="6" Padding="6" Background="Transparent">
        <StackPanel>
            <!-- Drag handle + title, shown only when unlocked. -->
            <Border x:Name="Header" Background="#E01B2130" CornerRadius="5" Padding="8,3" Margin="0,0,0,4"
                    Visibility="Collapsed" MouseLeftButtonDown="Header_DragMove">
                <TextBlock Text="Enemy DoTs — automatic" Foreground="#9FB4D0" FontWeight="Bold" FontSize="11"/>
            </Border>

            <TextBlock x:Name="Placeholder" Foreground="#7F93AD" FontSize="11" Margin="2,2,2,4"
                       Visibility="Collapsed"
                       Text="Your DoTs on enemies appear here on their own — no triggers needed."/>

            <ItemsControl x:Name="GroupsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <DockPanel Margin="2,4,2,1" MinWidth="230">
                                <TextBlock Text="{Binding Spell}" Foreground="#E57373" FontSize="10"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Height="1" Background="#3A2528" Margin="7,1,0,0"
                                        VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="RowBox" Margin="0,1" CornerRadius="4" Background="#C0141A24"
                                                Padding="6,3" BorderBrush="#3A2528" BorderThickness="1" MinWidth="230">
                                            <DockPanel>
                                                <Border x:Name="RowChip" DockPanel.Dock="Left" Width="4" CornerRadius="2"
                                                        Background="#E57373" Margin="0,0,7,0"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}"
                                                           Foreground="White" FontWeight="Bold" FontSize="12"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                <TextBlock Text="{Binding Label}" Foreground="#E2E6EC" FontSize="12"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="240"/>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- Overrun: past the estimate, fade not yet seen -
                                                 gray, counting up, still honest. -->
                                            <DataTrigger Binding="{Binding IsOverrun}" Value="True">
                                                <Setter TargetName="RowBox" Property="Opacity" Value="0.5"/>
                                                <Setter TargetName="RowChip" Property="Background" Value="#9AA3AF"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
