<Window x:Class="EQLOverlay.Views.IncomingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EQLOverlay.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Incoming damage (owner request, 11 Sep): the last N seconds of damage
         taken, melee red / spells violet, per second, and the stance verdict
         — the death recap's split, live. The chart is the shared
         IncomingStrip (21 Sep: it can also cap the DPS meter); this window
         is its free-floating frame. -->
    <Border x:Name="RootBorder" CornerRadius="8" Padding="10,8,10,9" Background="#E0141A24"
            BorderBrush="#3A4560" BorderThickness="1" Width="300">
        <StackPanel>
            <local:IncomingStrip x:Name="Strip"/>
            <TextBlock x:Name="Placeholder" Foreground="#5C6B82" FontSize="12" Margin="0,6,0,4"
                       HorizontalAlignment="Center" Visibility="Collapsed" Text="No damage taken in the last 15 s."/>
        </StackPanel>
    </Border>
</Window>
