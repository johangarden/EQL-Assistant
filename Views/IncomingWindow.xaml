<Window x:Class="EQLOverlay.Views.IncomingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Incoming damage (owner request, 11 Sep): the last N seconds of damage
         taken, melee red / spells violet, per second, and the stance verdict
         — the death recap's split, live. Header row → split bar → columns,
         nothing below; the verdict lives in the stance pill's colour. -->
    <Border x:Name="RootBorder" CornerRadius="8" Padding="10,8,10,9" Background="#E0141A24"
            BorderBrush="#3A4560" BorderThickness="1" Width="300">
        <StackPanel>
            <DockPanel x:Name="HeaderRow" Margin="0,0,0,6" MouseLeftButtonDown="Header_DragMove" Background="Transparent">
                <Border x:Name="StanceChip" DockPanel.Dock="Right" Padding="7,1,7,2" CornerRadius="8"
                        Background="#232B3D" BorderBrush="#3A4560" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StanceText" FontSize="10.5" FontWeight="Bold" Foreground="#C9D4E3"/>
                </Border>
                <TextBlock x:Name="TitleText" Text="INCOMING · LAST 15S" FontSize="10.5" FontWeight="Bold"
                           Foreground="#7F93AD" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="Placeholder" Foreground="#5C6B82" FontSize="12" Margin="0,6,0,4"
                       HorizontalAlignment="Center" Visibility="Collapsed" Text="No damage taken in the last 15 s."/>

            <StackPanel x:Name="Body">
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MeleeText" Grid.Column="0" FontSize="12" FontWeight="Bold" Foreground="#E57373"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Grid Grid.Column="1" Height="10" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="MeleeCol" Width="1*"/>
                            <ColumnDefinition x:Name="SpellCol" Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" Background="#0F141E" CornerRadius="4"/>
                        <Border x:Name="MeleeBar" Grid.Column="0" Background="#E57373" CornerRadius="4,0,0,4"/>
                        <Border x:Name="SpellBar" Grid.Column="1" Background="#9575CD" CornerRadius="0,4,4,0"/>
                    </Grid>
                    <TextBlock x:Name="SpellText" Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="#B39DDB"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <Border BorderBrush="#1F2637" BorderThickness="0,0,0,1" Padding="0,0,0,1">
                    <UniformGrid x:Name="Columns" Rows="1" Height="38"/>
                </Border>
                <!-- No verdict text below (owner, 15 Sep: "it's bloating the
                     panel") — the stance pill carries the verdict: green when
                     your stance halves the bigger half, red naming the stance
                     that would, grey when the mix favours neither. -->
                <Grid Margin="0,2,0,0">
                    <TextBlock x:Name="AxisLeft" FontFamily="Consolas" FontSize="9.5" Foreground="#5C6B82" HorizontalAlignment="Left"/>
                    <TextBlock Text="now" FontFamily="Consolas" FontSize="9.5" Foreground="#5C6B82" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
