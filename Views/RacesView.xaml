<UserControl x:Class="EQLOverlay.Views.RacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <!-- The Races tab (owner, 22 Sep): a badge per race like the Sky class
         badges — done first — then the selected race's three factions with
         standing bars and the mobs from your own log that moved them. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,2,8,8">
            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Foreground="#7F93AD" FontSize="11.5"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Right"/>
                <TextBlock Text="Races" Foreground="#C9D4E3" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="HintText" Foreground="#5C6B82" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel x:Name="BadgesHost"/>
            <StackPanel x:Name="DetailHost" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
