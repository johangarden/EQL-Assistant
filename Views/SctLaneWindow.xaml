<Window x:Class="EQLOverlay.Views.SctLaneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="RootBorder" CornerRadius="6" Padding="4" Background="Transparent">
        <StackPanel>
            <!-- Drag handle + title, shown only when unlocked. -->
            <Border x:Name="Header" Background="#E01B2130" CornerRadius="5" Padding="8,3" Margin="0,0,0,4"
                    Visibility="Collapsed" MouseLeftButtonDown="Header_DragMove">
                <TextBlock x:Name="HeaderText" Text="Lane" Foreground="#9FB4D0" FontWeight="Bold" FontSize="11"/>
            </Border>

            <Grid>
                <!-- Dashed outline so the lane is visible while placing it (unlocked only). -->
                <Rectangle x:Name="Outline" Stroke="#559FB4D0" StrokeDashArray="4 3" StrokeThickness="1"
                           RadiusX="6" RadiusY="6" Visibility="Collapsed"/>
                <Canvas x:Name="Lane" ClipToBounds="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
