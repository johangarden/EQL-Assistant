<Window x:Class="EQLOverlay.Views.SkillTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EQLOverlay.ViewModels"
        Title="EQL Assistant — Skills"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Drag anywhere on the card (buttons handle their own clicks). -->
    <Border x:Name="RootBorder" CornerRadius="10" Padding="10"
            Background="#D6141A24" BorderBrush="#3A4560" BorderThickness="1"
            MouseLeftButtonDown="Card_DragMove">
        <StackPanel Width="252">

            <DockPanel Margin="0,0,0,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Click="OnReset"
                        Margin="6,0,0,0" FontFamily="Segoe MDL2 Assets" Content="&#xE72C;"
                        AutomationProperties.AutomationId="SkillsResetBtn"
                        ToolTip="Reset the session counts"/>
                <TextBlock Text="Skills" Foreground="#C9D4E3" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <TextBlock x:Name="SummaryText" Text="" Foreground="#7F93AD"
                       FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>

            <!-- One bar per configured skill: fill = session hit rate. -->
            <ItemsControl x:Name="RowsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MeterRowViewModel}">
                        <Grid Height="17" Margin="0,0,0,3" ToolTip="{Binding Detail}">
                            <Border CornerRadius="3" Background="#C8101318"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FillStar}}"/>
                                    <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource RestStar}}"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Background="{Binding Fill}" Opacity="0.8"/>
                            </Grid>
                            <Border CornerRadius="3" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                            <Grid Margin="6,0">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Foreground="White" FontSize="11" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,138,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="{Binding ValueText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="White" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
