<Window x:Class="EQLOverlay.Views.SessionStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Overlay-native picker: the dialog ComboBox (Controls.xaml) is a form
         field; here the picker doubles as the panel title, so it wears the
         same pill look as the scope buttons below it. -->
    <Window.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#C9D4E4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#16283E"/>
                                <Setter Property="Foreground" Value="#4FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#C9D4E4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="Transparent"
                                                BorderBrush="#3A4560" BorderThickness="1"
                                                CornerRadius="9">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,1,8,0" Data="M0,0 L3.5,3.5 7,0"
                                                  Stroke="#7F93AD" StrokeThickness="1.4"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#5F7189"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4FC3F7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="9,1,22,2" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#F20F1520" BorderBrush="#3A4560" BorderThickness="1"
                                        CornerRadius="4" Padding="3" Margin="0,3,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="6" Padding="8,6" Background="#C0101620"
            BorderBrush="#2A3648" BorderThickness="1" MinWidth="248">
        <StackPanel>
            <!-- Drag handle + slice picker; the picker doubles as the title. -->
            <DockPanel x:Name="Header" Margin="0,0,0,4" Background="Transparent"
                       MouseLeftButtonDown="Header_DragMove">
                <TextBlock x:Name="LevelText" DockPanel.Dock="Right" Foreground="#7F93AD"
                           FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock DockPanel.Dock="Left" Text="XP" Foreground="#5F7189" FontSize="10"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <ComboBox x:Name="SliceBox" FontSize="11" MinWidth="122" Height="20"
                          HorizontalAlignment="Left" SelectionChanged="Slice_Changed"/>
            </DockPanel>

            <ItemsControl x:Name="RowsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Foreground="#7F93AD"
                                       FontSize="10" FontWeight="Bold" Width="76"
                                       VerticalAlignment="Center" ToolTip="{Binding Tip}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="#7F93AD"
                                       FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Tip}">
                                <TextBlock Text="{Binding Value}" Foreground="#E2E6EC" FontSize="15"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Unit}" Foreground="#9FB4D0" FontSize="10"
                                           VerticalAlignment="Center" Margin="4,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="CaptionText" Foreground="#5F7189" FontSize="10"
                       Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="260"/>

            <!-- Scope pills: tier scoping + rate basis (RaidKills segment look). -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Border x:Name="TierBtn" CornerRadius="9" Padding="8,2" Margin="0,0,5,0"
                        Cursor="Hand" BorderBrush="#3A4560" BorderThickness="1"
                        MouseLeftButtonUp="Tier_Click">
                    <TextBlock x:Name="TierBtnText" FontSize="10"/>
                </Border>
                <Border x:Name="BasisBtn" CornerRadius="9" Padding="8,2"
                        Cursor="Hand" BorderBrush="#3A4560" BorderThickness="1"
                        MouseLeftButtonUp="Basis_Click">
                    <TextBlock x:Name="BasisBtnText" FontSize="10"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
