<Window x:Class="EQLOverlay.Views.MezWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- The mez panel (owner request 14 Sep, mocked first): a row per mezzed
         mob, sorted by time left — violet running, amber in the last stretch
         (re-mez now), red the moment anyone damages it (and who), dashed
         while assumed. Hidden when locked and empty. -->
    <Border x:Name="RootBorder" CornerRadius="8" Padding="11,9,11,10" Background="#E0141A24"
            BorderBrush="#3A4560" BorderThickness="1" Width="320">
        <StackPanel>
            <DockPanel x:Name="HeaderRow" MouseLeftButtonDown="Header_DragMove" Background="Transparent" Margin="0,0,0,4">
                <Border DockPanel.Dock="Left" Padding="7,1,7,2" CornerRadius="4" Background="#2A3350"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="MEZ" FontSize="10" FontWeight="Bold" Foreground="#B39DDB"/>
                </Border>
                <TextBlock x:Name="NextText" DockPanel.Dock="Right" FontSize="11.5" FontWeight="Bold" Foreground="#FFB74D"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="SummaryText" FontSize="11.5" Foreground="#7F93AD" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <TextBlock x:Name="Placeholder" Foreground="#5C6B82" FontSize="12" Margin="0,6,0,2"
                       HorizontalAlignment="Center" Visibility="Collapsed"
                       Text="Mobs you mesmerize list here — with the time left and who broke it."/>

            <ItemsControl x:Name="RowsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowBox" BorderBrush="#2A3348" BorderThickness="0,1,0,0" Padding="0,6,0,7">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Text="{Binding TimeText}"
                                               Foreground="#B39DDB" FontWeight="Bold" FontSize="12.5"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Label}" Foreground="#C9D4E3" FontSize="12.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Grid Height="6" Margin="0,5,0,3" Width="296" HorizontalAlignment="Left">
                                    <Border Background="#0F141E" CornerRadius="3"/>
                                    <Border x:Name="Fill" Background="#9575CD" CornerRadius="3" HorizontalAlignment="Left"
                                            Width="{Binding FillWidth}"/>
                                </Grid>
                                <DockPanel>
                                    <TextBlock x:Name="RightText" DockPanel.Dock="Right" Text="{Binding RightText}" FontSize="11" Foreground="#7F93AD"/>
                                    <TextBlock x:Name="SubText" Text="{Binding SubText}" FontSize="11" Foreground="#7F93AD" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding First}" Value="True">
                                <Setter TargetName="RowBox" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="RowBox" Property="Padding" Value="0,2,0,7"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Due}" Value="True">
                                <Setter TargetName="TimeText" Property="Foreground" Value="#FFB74D"/>
                                <Setter TargetName="Fill" Property="Background" Value="#FFB74D"/>
                                <Setter TargetName="SubText" Property="Foreground" Value="#FFB74D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Assumed}" Value="True">
                                <Setter TargetName="TimeText" Property="Opacity" Value="0.75"/>
                                <Setter TargetName="Fill" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="SubText" Property="Foreground" Value="#FFB74D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Broke}" Value="True">
                                <Setter TargetName="TimeText" Property="Foreground" Value="#FF8A80"/>
                                <Setter TargetName="Fill" Property="Background" Value="#E57373"/>
                                <Setter TargetName="SubText" Property="Foreground" Value="#FF8A80"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
