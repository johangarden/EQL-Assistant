<Window x:Class="EQLOverlay.Views.TriggerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Manager"
        Icon="/assets/eqloverlay.ico"
        Width="960" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#141A24">

    <!-- Dark theme, matching the overlay panels / fight-history window.
         Scoped to this window so app-wide defaults stay untouched. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCE6F5"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C9D4E3"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#7F93AD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="PageTitle" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitle" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#232B3D"/>
            <Setter Property="Foreground" Value="#DCE6F5"/>
            <Setter Property="BorderBrush" Value="#3A4560"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="CaretBrush" Value="#DCE6F5"/>
            <Setter Property="SelectionBrush" Value="#2E6FB0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4A5A78"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#57A0DE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE6F5"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DCE6F5"/>
            <Setter Property="Background" Value="#2A3346"/>
            <Setter Property="BorderBrush" Value="#4A5A78"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3C4A63"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#22608F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1B2130"/>
            <Setter Property="Foreground" Value="#DCE6F5"/>
            <Setter Property="BorderBrush" Value="#3A4560"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#DCE6F5"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3346"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E6FB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar navigation entries: roomier, pill-shaped. -->
        <Style TargetType="ListBoxItem" x:Key="NavItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A3346"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E6FB0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#DCE6F5"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E6FB0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#DCE6F5"/>
            <Setter Property="MinHeight" Value="27"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="#232B3D" BorderBrush="#3A4560"
                                                BorderThickness="1" CornerRadius="3">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,9,0" Data="M0,0 L4,4 8,0"
                                                  Stroke="#8FA6C4" StrokeThickness="1.5"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A5A78"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Selected" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,26,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#DCE6F5" CaretBrush="#DCE6F5"
                                     Margin="3,1,24,1" VerticalContentAlignment="Center"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#1B2130" BorderBrush="#3A4560" BorderThickness="1"
                                        CornerRadius="3" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="Selected" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#C9D4E3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter ContentSource="Header" Margin="2,0,0,4"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="#C9D4E3"/>
                            <Border Grid.Row="1" BorderBrush="#3A4560" BorderThickness="1"
                                    CornerRadius="4" Padding="8">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One reusable anchor picker items list (cloned per combo below). -->
        <Style TargetType="Border" x:Key="PageSep">
            <Setter Property="BorderBrush" Value="#3A4560"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Margin" Value="0,16,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom" Background="#1B2130" Padding="10,8"
                BorderBrush="#3A4560" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusText" Foreground="#6FCF97" VerticalAlignment="Center"/>
                <Button Content="Close" Click="Close_Click" DockPanel.Dock="Right"
                        Width="90" Height="30" Margin="8,0,0,0"/>
                <Button Content="Save" Click="Save_Click" DockPanel.Dock="Right"
                        Width="120" Height="30" FontWeight="Bold"
                        Background="#2E6FB0" BorderBrush="#57A0DE"/>
            </DockPanel>
        </Border>

        <DockPanel Margin="8">
            <!-- Sidebar navigation: one page per feature. -->
            <Border DockPanel.Dock="Left" Background="#10151F" CornerRadius="6" Padding="6"
                    Margin="0,0,8,0" Width="168">
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Content="Triggers" IsSelected="True"/>
                    <ListBoxItem Content="General"/>
                    <ListBoxItem Content="Buff bars"/>
                    <ListBoxItem Content="Repop timer"/>
                    <ListBoxItem Content="DPS meter"/>
                    <ListBoxItem Content="Combat text"/>
                    <ListBoxItem Content="Flash alerts"/>
                </ListBox>
            </Border>

            <Border Background="#1B2130" BorderBrush="#3A4560" BorderThickness="1" CornerRadius="6"
                    Padding="4">
                <Grid>
                    <!-- ============================ TRIGGERS ============================ -->
                    <Grid x:Name="TriggersPage" Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="210"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Loadout bar -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                Background="#232B3D" Padding="8,6" CornerRadius="4">
                            <DockPanel>
                                <TextBlock Text="Loadout:" FontWeight="Bold" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="New"       Click="NewLoadout_Click"       Width="56" Margin="4,0,0,0"/>
                                    <Button Content="Rename"    Click="RenameLoadout_Click"    Width="64" Margin="4,0,0,0"/>
                                    <Button Content="Duplicate" Click="DuplicateLoadout_Click" Width="76" Margin="4,0,0,0"/>
                                    <Button Content="Delete"    Click="DeleteLoadout_Click"    Width="60" Margin="4,0,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="LoadoutCombo" SelectionChanged="LoadoutCombo_SelectionChanged"
                                          MinWidth="220" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </Border>

                        <!-- Trigger list -->
                        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Add"       Click="Add_Click"       Width="46" Margin="0,0,4,0"/>
                                <Button Content="Library…"  Click="Library_Click"   Width="64" Margin="0,0,4,0"
                                        Background="#2E6FB0" BorderBrush="#57A0DE"
                                        AutomationProperties.AutomationId="LibraryBtn"
                                        ToolTip="Add ready-made triggers from the ~1400-spell library"/>
                                <Button Content="Duplicate" Click="Duplicate_Click" Width="66" Margin="0,0,4,0"/>
                                <Button Content="Delete"    Click="Delete_Click"    Width="52" Margin="0,0,4,0"/>
                                <Button Content="↑"         Click="MoveUp_Click"    Width="26" Margin="0,0,4,0"/>
                                <Button Content="↓"         Click="MoveDown_Click"  Width="26"/>
                            </StackPanel>
                            <ListBox x:Name="TriggerList" SelectionChanged="TriggerList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="13" Height="13" CornerRadius="2"
                                                    Background="{Binding PreviewBrush}"
                                                    Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Details -->
                        <ScrollViewer x:Name="DetailsScroller" Grid.Row="1" Grid.Column="1"
                                      VerticalScrollBarVisibility="Auto" IsEnabled="False">
                            <StackPanel Margin="4,0,8,8">
                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}"
                                          FontWeight="Bold" Margin="0,4,0,0"/>

                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Show in" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="PanelCombo" SelectedValuePath="Tag" SelectedValue="{Binding Panel}"
                                          SelectionChanged="PanelCombo_SelectionChanged"
                                          AutomationProperties.AutomationId="PanelCombo">
                                    <ComboBoxItem Content="Bars — countdown timers" Tag="bars"/>
                                    <ComboBoxItem Content="Self buffs — present/missing matrix" Tag="selfBuffs"/>
                                    <ComboBoxItem Content="Target debuffs — present/missing matrix" Tag="targetDebuffs"/>
                                    <ComboBoxItem Content="Flash — screen-center alert" Tag="flash"/>
                                </ComboBox>
                                <TextBlock x:Name="PanelHint" Style="{StaticResource Hint}"
                                           Text="A depleting countdown bar in the bars panel, grouped by category."/>

                                <StackPanel x:Name="CategoryGroup">
                                    <TextBlock Text="Category (bars grouping)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox IsEditable="True" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem>Buffs</ComboBoxItem>
                                        <ComboBoxItem>HoTs</ComboBoxItem>
                                        <ComboBoxItem>DoTs</ComboBoxItem>
                                        <ComboBoxItem>Cooldowns</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel x:Name="DurationGroup">
                                    <TextBlock x:Name="DurationLabel" Text="Duration (seconds)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding DurationSeconds}" Width="120" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <StackPanel x:Name="ColorGroup">
                                    <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="120"/>
                                        <Border Width="26" Height="20" Margin="8,0,0,0" CornerRadius="3"
                                                BorderBrush="#5C6B82" BorderThickness="1"
                                                Background="{Binding PreviewBrush}"/>
                                        <WrapPanel x:Name="SwatchPanel" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="StartLabel" Text="Start pattern (regex — starts the bar)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding StartPattern, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Tip: select a line in the log below and click '→ Start pattern' to fill this."/>

                                <StackPanel x:Name="EndGroup">
                                    <TextBlock Text="End pattern (regex — clears it early, optional)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EndPattern, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel x:Name="BarsChecksGroup">
                                    <CheckBox Content="Refresh to full when it triggers again"
                                              IsChecked="{Binding RefreshOnRetrigger}" Margin="0,10,0,0"/>
                                    <CheckBox Content="Remind me to rebuff when this is missing"
                                              IsChecked="{Binding RemindWhenMissing}" Margin="0,6,0,0"/>
                                </StackPanel>

                                <Border BorderBrush="#3A4560" BorderThickness="0,1,0,0" Margin="0,12,0,4"/>
                                <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}"/>

                                <StackPanel x:Name="WarnGroup">
                                    <TextBlock Text="Warn this many seconds before it drops (0 = off)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding AlertAtSeconds}" Width="120" HorizontalAlignment="Left"/>
                                    <CheckBox Content="Alert when it reaches 0 (use for cooldown 'ready')"
                                              IsChecked="{Binding AlertOnExpire}" Margin="0,8,0,0"/>
                                </StackPanel>

                                <StackPanel x:Name="FlashGroup">
                                    <TextBlock x:Name="FlashLabel" Text="Flash this text on screen when it matches (optional)"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding FlashText, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Big text in the trigger's colour in the flash area, fading out. Size and position: Flash alerts page."/>
                                </StackPanel>

                                <StackPanel x:Name="SpeakSoundGroup">
                                    <TextBlock Text="Speak this phrase (Windows text-to-speech)" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding AlertSpeak, UpdateSourceTrigger=PropertyChanged}" Width="320"/>
                                        <Button Content="Speak" Click="Speak_Click" Width="60" Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="Play this .wav file" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding AlertSound, UpdateSourceTrigger=PropertyChanged}" Width="320"/>
                                        <Button Content="Browse" Click="BrowseSound_Click" Width="66" Margin="8,0,0,0"/>
                                        <Button Content="Play" Click="PlaySound_Click" Width="50" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Live log capture -->
                        <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                  Header="Live log — click a line, then send it to a pattern" Margin="0,8,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Width="150" Margin="8,0,0,0">
                                    <Button Content="→ Start pattern" Click="UseAsStart_Click" Margin="0,0,0,4"/>
                                    <Button Content="→ End pattern"   Click="UseAsEnd_Click"   Margin="0,0,0,4"/>
                                    <CheckBox x:Name="PauseFeedCheck" Content="Pause feed" Margin="0,6,0,0"/>
                                    <Button Content="Clear" Click="ClearFeed_Click" Margin="0,6,0,0"/>
                                    <Border BorderBrush="#3A4560" BorderThickness="0,1,0,0" Margin="0,8,0,6"/>
                                    <TextBlock Text="Test a line:" FontWeight="SemiBold"/>
                                    <Button Content="Test matches" Click="Test_Click" Margin="0,4,0,0"/>
                                </StackPanel>
                                <DockPanel>
                                    <TextBox x:Name="TestLineBox" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                             FontFamily="Consolas"
                                             ToolTip="Paste a log line here and click 'Test matches'."/>
                                    <TextBlock x:Name="TestResult" DockPanel.Dock="Bottom"
                                               Foreground="#7F93AD" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <ListBox x:Name="RecentList" FontFamily="Consolas" FontSize="12"/>
                                </DockPanel>
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <!-- ============================ GENERAL ============================ -->
                    <ScrollViewer x:Name="GeneralPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="App-wide basics. Each overlay feature has its own page in the sidebar."/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Log source" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Log folder (newest eqlog_*.txt is followed)" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="LogDirBox" Width="440"/>
                                <Button Content="Browse" Click="BrowseLogDir_Click" Width="66" Margin="8,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="File pattern" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FilePatternBox" Width="220" HorizontalAlignment="Left"/>

                            <TextBlock Text="Or one explicit file (overrides folder+pattern)" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="ExplicitFileBox" Width="440"/>
                                <Button Content="Browse" Click="BrowseFile_Click" Width="66" Margin="8,0,0,0"/>
                            </StackPanel>

                            <CheckBox x:Name="StartAtEndCheck" Content="Start at end of file (ignore old history)"
                                      Margin="0,10,0,0"/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Character" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Used by the DPS meter, fight history and combat text to recognize you and your pet in log lines."/>

                            <TextBlock Text="Character name (leave empty to auto-detect from the log filename)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="CharNameBox" Width="220" HorizontalAlignment="Left"/>
                            <TextBlock Text="Pet name (optional)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PetNameBox" Width="220" HorizontalAlignment="Left"/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Overlay" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Opacity (0.1 – 1.0, lower = more see-through)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="OpacityBox" Width="120" HorizontalAlignment="Left"/>
                            <CheckBox x:Name="StartLockedCheck" Content="Start locked (game-ready: click-through, no toolbar)"
                                      Margin="0,10,0,0"/>
                            <CheckBox x:Name="MuteCheck" Content="Mute all alerts" Margin="0,6,0,0"/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Session" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="So a forgotten start never costs you data: launch with Windows, and/or rebuild today's fight history, raid kills and seen spells from the log when the app starts late (also on demand: tray → 'Catch up from today's log')."/>

                            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows (this exe)" Margin="0,10,0,0"/>
                            <CheckBox x:Name="CatchUpCheck" Content="Catch up from today's log on startup" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ BUFF BARS + MATRICES ============================ -->
                    <ScrollViewer x:Name="BarsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="Buff bars" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The countdown-bar panel. Bar triggers are created under Triggers → 'Bars'."/>

                            <TextBlock Text="Width" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="WidthBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Bar height (thinner bars = lower value)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BarHeightBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Font size" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FontSizeBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Warn seconds (bar flashes under this)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="WarnBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Missing-buff reminder interval (seconds)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RemindBox" Width="120" HorizontalAlignment="Left"/>
                            <CheckBox x:Name="ShowHeadersCheck" Content="Show category headers" Margin="0,10,0,0"/>

                            <TextBlock Text="Screen anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="BarsAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Panels stick to their corner and grow away from it — Bottom-left keeps the panel above your hotbar and grows upward."/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Buff / debuff matrices" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The red/green present-missing cell panels. Cell triggers: Triggers → 'Self buffs' or 'Target debuffs'."/>

                            <TextBlock Text="Columns" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MatrixColumnsBox" Width="120" HorizontalAlignment="Left"/>

                            <TextBlock Text="Self-buffs anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SelfAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>

                            <TextBlock Text="Target-debuffs anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TargetAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ REPOP TIMER ============================ -->
                    <ScrollViewer x:Name="TimerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="Repop timer" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The circular respawn watch. Toggle in game: ⏱ toolbar button, tray, or Ctrl+Alt+R."/>

                            <CheckBox x:Name="TimerVisibleCheck" Content="Visible at startup" Margin="0,12,0,0"/>

                            <TextBlock Text="Screen anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TimerAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Named respawns" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Global — these work no matter which loadout is active. When the mob's death line appears in the log, the watch auto-starts with its respawn time (and the mob shows in the watch's ☰ menu)."/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="280"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Add" Click="RespawnAdd_Click" Width="52" Margin="0,0,4,0"
                                                AutomationProperties.AutomationId="RespawnAddBtn"/>
                                        <Button Content="Delete" Click="RespawnDelete_Click" Width="60"/>
                                    </StackPanel>
                                    <ListBox x:Name="RespawnList" Height="150"
                                             SelectionChanged="RespawnList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Recent kills" FontWeight="SemiBold" Foreground="#C9D4E3"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="← Add as respawn" Click="RespawnFromDeath_Click"
                                                AutomationProperties.AutomationId="RespawnFromDeathBtn"/>
                                    </StackPanel>
                                    <ListBox x:Name="RecentDeathsList" Height="150"
                                             MouseDoubleClick="RespawnFromDeath_Click"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="The last 10 deaths seen in the log. Pick one, add it, set its respawn time — done."/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="RespawnEditor" IsEnabled="False">
                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" FontWeight="Bold" Margin="0,10,0,0"/>

                                <TextBlock Text="Mob name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"/>

                                <TextBlock Text="Respawn time (seconds)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Seconds}" Width="120" HorizontalAlignment="Left"/>

                                <TextBlock Text="Death line (regex — optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Leave empty to match '&lt;Mob name&gt; has been slain by …' and 'You have slain &lt;Mob name&gt;' automatically."/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ DPS METER ============================ -->
                    <ScrollViewer x:Name="MeterPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="DPS meter" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Live rankings with the incoming-damage footer. Fight history, comparisons and raid kills open from the meter's buttons. Character and pet names: General page. Toggle in game: 📊 toolbar button, tray, or Ctrl+Alt+D."/>

                            <CheckBox x:Name="MeterVisibleCheck" Content="Visible at startup" Margin="0,12,0,0"/>

                            <TextBlock Text="Screen anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="MeterAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ COMBAT TEXT ============================ -->
                    <ScrollViewer x:Name="SctPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="Scrolling combat text" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Floating numbers in fixed lanes — each lane is its own movable panel (unlock with Ctrl+Alt+L to drag them). Master toggle in game: ⚡ toolbar button, tray, or Ctrl+Alt+C. Pet lanes need a Pet name (General page)."/>

                            <CheckBox x:Name="SctVisibleCheck" Content="Visible at startup" Margin="0,12,0,0"/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Lanes" Style="{StaticResource SectionTitle}"/>

                            <CheckBox x:Name="SctIncomingCheck" Content="Incoming damage (you)" Margin="0,10,0,0"/>
                            <CheckBox x:Name="SctOutgoingCheck" Content="Outgoing damage (you)" Margin="0,6,0,0"/>
                            <CheckBox x:Name="SctHealsCheck" Content="Your heals" Margin="0,6,0,0"/>
                            <CheckBox x:Name="SctHealsInCheck" Content="Heals on you (from others)" Margin="0,6,0,0"/>
                            <CheckBox x:Name="SctPetInCheck" Content="Pet incoming damage" Margin="0,6,0,0"/>
                            <CheckBox x:Name="SctPetOutCheck" Content="Pet outgoing damage" Margin="0,6,0,0"/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Number size" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SctFontBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Big-hit threshold (hits at/above render larger)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SctBigHitBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Lane width" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SctLaneWidthBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Lane height" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SctLaneHeightBox" Width="120" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ FLASH ALERTS ============================ -->
                    <ScrollViewer x:Name="FlashPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="Flash alerts" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The screen-flash area. Flash triggers (and per-trigger flash text) are created under Triggers. Unlock the overlay (Ctrl+Alt+L) to see and drag the area."/>

                            <TextBlock Text="Flash text size" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FlashFontBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Flash area width (text wraps inside)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FlashWidthBox" Width="120" HorizontalAlignment="Left"/>

                            <TextBlock Text="Screen anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="FlashAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
