<Window x:Class="EQLOverlay.Views.TriggerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Manager"
        Icon="/assets/eqloverlay.ico"
        Width="960" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}">

    <!-- Shared dark theme; only window-specific styles live here. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Sidebar navigation entries: roomier, pill-shaped. -->
            <Style TargetType="ListBoxItem" x:Key="NavItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Control}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Accent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar section headers (not selectable). -->
            <Style TargetType="ListBoxItem" x:Key="NavHeader">
                <Setter Property="IsEnabled" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{StaticResource Brush.TextFaint}"
                                       FontSize="10" FontWeight="Bold" Margin="10,12,0,4"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Scope chips beside page titles: what a page's settings apply to. -->
            <Style TargetType="Border" x:Key="ScopeChip">
                <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="ScopeChipText">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextHint}"/>
            </Style>
            <Style TargetType="Border" x:Key="LoadoutChip" BasedOn="{StaticResource ScopeChip}">
                <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="LoadoutChipText" BasedOn="{StaticResource ScopeChipText}">
                <Setter Property="Foreground" Value="White"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom" Background="#1B2130" Padding="10,8"
                BorderBrush="#3A4560" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusText" Foreground="#6FCF97" VerticalAlignment="Center"/>
                <Button Content="Close" Click="Close_Click" DockPanel.Dock="Right"
                        Width="90" Height="30" Margin="8,0,0,0"/>
                <Button Content="Save" Click="Save_Click" DockPanel.Dock="Right"
                        Width="120" Height="30" FontWeight="Bold"
                        Style="{StaticResource PrimaryBtn}"/>
            </DockPanel>
        </Border>

        <DockPanel Margin="8">
            <!-- Sidebar navigation: one page per feature. -->
            <Border DockPanel.Dock="Left" Background="{StaticResource Brush.Sunken}" CornerRadius="6" Padding="6"
                    Margin="0,0,8,0" Width="168">
                <DockPanel>
                    <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Content="TRIGGERS" Style="{StaticResource NavHeader}"/>
                    <ListBoxItem Content="Triggers" IsSelected="True"/>
                    <ListBoxItem Content="Loadouts"/>
                    <ListBoxItem Content="PANELS" Style="{StaticResource NavHeader}"/>
                    <ListBoxItem Content="Bars &amp; matrices"/>
                    <ListBoxItem Content="Repop timer"/>
                    <ListBoxItem Content="DPS &amp; Skills"/>
                    <ListBoxItem Content="Combat text"/>
                    <ListBoxItem Content="Flash alerts"/>
                    <ListBoxItem Content="Death recap"/>
                    <ListBoxItem Content="KNOWLEDGE" Style="{StaticResource NavHeader}"/>
                    <ListBoxItem Content="Respawns"/>
                    <ListBoxItem Content="APP" Style="{StaticResource NavHeader}"/>
                    <ListBoxItem Content="General"/>
                    <ListBoxItem Content="Data"/>
                    <ListBoxItem Content="Shortcuts"/>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Background="#1B2130" BorderBrush="#3A4560" BorderThickness="1" CornerRadius="6"
                    Padding="4">
                <Grid>
                    <!-- ============================ TRIGGERS ============================ -->
                    <Grid x:Name="TriggersPage" Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="210"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Loadout bar -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                Background="#232B3D" Padding="8,6" CornerRadius="4">
                            <DockPanel>
                                <TextBlock Text="Loadout:" FontWeight="Bold" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Border DockPanel.Dock="Right" Style="{StaticResource LoadoutChip}" Margin="8,0,0,0"
                                        ToolTip="Triggers belong to the selected loadout — switching loadouts switches the whole set. Everything else in the Manager is global. Create/rename/delete loadouts on the Loadouts page.">
                                    <TextBlock Style="{StaticResource LoadoutChipText}" Text="PER LOADOUT"/>
                                </Border>
                                <ComboBox x:Name="LoadoutCombo" SelectionChanged="LoadoutCombo_SelectionChanged"
                                          MinWidth="220" HorizontalAlignment="Left"/>
                            </DockPanel>
                        </Border>

                        <!-- Trigger list -->
                        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="Library…"  Click="Library_Click"   Width="70" Margin="0,0,4,0"
                                        Style="{StaticResource PrimaryBtn}"
                                        AutomationProperties.AutomationId="LibraryBtn"
                                        ToolTip="Add ready-made triggers from the ~1400-spell library"/>
                                <Button Content="Add"       Click="Add_Click"       Width="46" Margin="0,0,4,0"
                                        ToolTip="Add a blank trigger to fill in manually"/>
                                <Button Content="Delete"    Click="Delete_Click"    Width="52" Margin="0,0,4,0"/>
                                <!-- Reordering only matters for matrix triggers (cells lay out in
                                     list order); bars always sort by time left. Shown contextually. -->
                                <Button x:Name="MoveUpBtn" Content="↑" Click="MoveUp_Click" Width="26" Margin="0,0,4,0"
                                        Visibility="Collapsed" ToolTip="Move up — matrix cells lay out in this order"/>
                                <Button x:Name="MoveDownBtn" Content="↓" Click="MoveDown_Click" Width="26"
                                        Visibility="Collapsed" ToolTip="Move down — matrix cells lay out in this order"/>
                            </StackPanel>
                            <ListBox x:Name="TriggerList" SelectionChanged="TriggerList_SelectionChanged">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="2,9,4,3">
                                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold"
                                                               Foreground="#5C6B82" VerticalAlignment="Center"/>
                                                    <Border Height="1" Background="#2A3347"
                                                            Margin="8,1,0,0" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Opacity="{Binding ListOpacity}">
                                            <Border Width="13" Height="13" CornerRadius="2"
                                                    Background="{Binding PreviewBrush}"
                                                    Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- Details -->
                        <ScrollViewer x:Name="DetailsScroller" Grid.Row="1" Grid.Column="1"
                                      VerticalScrollBarVisibility="Auto" IsEnabled="False">
                            <StackPanel Margin="4,0,8,8">
                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}"
                                          FontWeight="Bold" Margin="0,4,0,0"/>

                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Show in" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="PanelCombo" SelectedValuePath="Tag" SelectedValue="{Binding Panel}"
                                          SelectionChanged="PanelCombo_SelectionChanged"
                                          AutomationProperties.AutomationId="PanelCombo">
                                    <ComboBoxItem Content="Bars — countdown timers" Tag="bars"/>
                                    <ComboBoxItem Content="Self buffs — present/missing matrix" Tag="selfBuffs"/>
                                    <ComboBoxItem Content="Target debuffs — present/missing matrix" Tag="targetDebuffs"/>
                                    <ComboBoxItem Content="Flash — screen-center alert" Tag="flash"/>
                                </ComboBox>
                                <TextBlock x:Name="PanelHint" Style="{StaticResource Hint}"
                                           Text="A depleting countdown bar in the bars panel, grouped by category."/>

                                <StackPanel x:Name="CategoryGroup">
                                    <TextBlock Text="Type (grouping — sets the bar color)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox IsEditable="True" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBoxItem>Buffs</ComboBoxItem>
                                        <ComboBoxItem>HoTs</ComboBoxItem>
                                        <ComboBoxItem>DoTs</ComboBoxItem>
                                        <ComboBoxItem>Debuffs</ComboBoxItem>
                                        <ComboBoxItem>Cooldowns</ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Each type owns its color: Buffs blue · HoTs green · DoTs red · Debuffs yellow · Cooldowns purple."/>
                                </StackPanel>

                                <StackPanel x:Name="DurationGroup">
                                    <TextBlock x:Name="DurationLabel" Text="Duration" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="DurationBox" Text="{Binding DurationText}" Width="120"
                                                 ToolTip="660, 11m, 9m12s or 9:12"/>
                                        <TextBlock x:Name="DurationEffectiveText" Style="{StaticResource Hint}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <CheckBox x:Name="DurationAutoCheck" IsChecked="{Binding DurationAuto}"
                                              Checked="DurationAuto_Changed" Unchecked="DurationAuto_Changed"
                                              Content="Auto-learn the real duration from the log" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="DurationAutoHint" Style="{StaticResource Hint}" Margin="0,3,0,0"
                                               Text="Auto-learn: the value above is only the starting point (library/base value) — every clean cast-to-fade your log shows refines it, in either direction. Untick to enter and enforce an exact time; learning still runs in the background so you can turn it back on later."/>
                                </StackPanel>

                                <TextBlock x:Name="StartLabel" Text="Start pattern (regex — starts the bar)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding StartPattern, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Tip: select a line in the log below and click '→ Start pattern' to fill this."/>

                                <StackPanel x:Name="AnchorGroup">
                                    <CheckBox x:Name="CastAnchorCheck" Margin="0,8,0,0"
                                              Checked="CastAnchor_Changed" Unchecked="CastAnchor_Changed"
                                              Content="Only my own cast starts it (cast-anchored)"/>
                                    <TextBlock x:Name="CastAnchorHint" Style="{StaticResource Hint}" Margin="0,3,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel x:Name="EndGroup">
                                    <TextBlock Text="End pattern (regex — clears it early, optional)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EndPattern, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel x:Name="BarsChecksGroup">
                                    <CheckBox Content="Refresh to full when it triggers again"
                                              IsChecked="{Binding RefreshOnRetrigger}" Margin="0,10,0,0"/>
                                    <CheckBox Content="Remind me to rebuff when this is missing"
                                              IsChecked="{Binding RemindWhenMissing}" Margin="0,6,0,0"/>

                                    <TextBlock Text="Cooldown reducer (regex — each match cuts time off the running bar, optional)"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ReducePattern, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" TextWrapping="Wrap"
                                             AutomationProperties.AutomationId="ReducePatternBox"/>
                                    <TextBlock Text="Seconds cut per match" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ReduceSeconds}" Width="120" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="SK example: a Cooldowns bar 'Harm Touch' starting on '^You begin casting Harm Touch' (1200s) with reducer '^You reave ' cutting 60 — the bar jumps on every landed reave and '-60s' floats in the XP &amp; faction lane. 'Alert at 0' then announces it's ready."/>
                                </StackPanel>

                                <Border BorderBrush="#3A4560" BorderThickness="0,1,0,0" Margin="0,12,0,4"/>
                                <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}"/>

                                <StackPanel x:Name="WarnGroup">
                                    <TextBlock Text="Warn this many seconds before it drops (0 = off)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding AlertAtSeconds}" Width="120" HorizontalAlignment="Left"/>
                                    <CheckBox Content="Alert when it reaches 0 (use for cooldown 'ready')"
                                              IsChecked="{Binding AlertOnExpire}" Margin="0,8,0,0"/>
                                </StackPanel>

                                <StackPanel x:Name="FlashGroup">
                                    <TextBlock x:Name="FlashLabel" Text="Flash this text on screen when it matches (optional)"
                                               Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding FlashText, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Big text in the trigger's colour in the flash area, fading out. Size and position: Flash alerts page."/>
                                </StackPanel>

                                <StackPanel x:Name="SpeakSoundGroup">
                                    <TextBlock Text="Speak this phrase (Windows text-to-speech)" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding AlertSpeak, UpdateSourceTrigger=PropertyChanged}" Width="320"/>
                                        <Button Content="Speak" Click="Speak_Click" Width="60" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding AlertSpeakEnabled}" Margin="0,6,0,0"
                                              Content="Voice on"
                                              ToolTip="Off keeps the phrase for later but never speaks it — library triggers arrive with a default fade warning you can simply switch off"/>

                                    <TextBlock Text="Play this .wav file" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding AlertSound, UpdateSourceTrigger=PropertyChanged}" Width="320"/>
                                        <Button Content="Browse" Click="BrowseSound_Click" Width="66" Margin="8,0,0,0"/>
                                        <Button Content="Play" Click="PlaySound_Click" Width="50" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Live log capture -->
                        <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                  Header="Live log — click a line, then send it to a pattern" Margin="0,8,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Width="150" Margin="8,0,0,0">
                                    <Button Content="→ Start pattern" Click="UseAsStart_Click" Margin="0,0,0,4"/>
                                    <Button Content="→ End pattern"   Click="UseAsEnd_Click"   Margin="0,0,0,4"/>
                                    <CheckBox x:Name="PauseFeedCheck" Content="Pause feed" Margin="0,6,0,0"/>
                                    <Button Content="Clear" Click="ClearFeed_Click" Margin="0,6,0,0"/>
                                    <Border BorderBrush="#3A4560" BorderThickness="0,1,0,0" Margin="0,8,0,6"/>
                                    <TextBlock Text="Test a line:" FontWeight="SemiBold"/>
                                    <Button Content="Test matches" Click="Test_Click" Margin="0,4,0,0"/>
                                </StackPanel>
                                <DockPanel>
                                    <TextBox x:Name="TestLineBox" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                             FontFamily="Consolas"
                                             ToolTip="Paste a log line here and click 'Test matches'."/>
                                    <TextBlock x:Name="TestResult" DockPanel.Dock="Bottom"
                                               Foreground="#7F93AD" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <ListBox x:Name="RecentList" FontFamily="Consolas" FontSize="12"/>
                                </DockPanel>
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <!-- ============================ LOADOUTS ============================ -->
                    <ScrollViewer x:Name="LoadoutsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="Loadouts" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="A loadout is a complete trigger set — one per class, character or situation. The overlay runs ONE active loadout at a time (switch in game: toolbar Loadout ▾ or tray); the Triggers page edits whichever loadout is selected here. Respawns, panels and everything else are global and unaffected by switching."/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                                <Button Content="New"       Click="NewLoadout_Click"       Width="56"/>
                                <Button Content="Rename"    Click="RenameLoadout_Click"    Width="64" Margin="4,0,0,0"/>
                                <Button Content="Duplicate" Click="DuplicateLoadout_Click" Width="76" Margin="4,0,0,0"/>
                                <Button Content="Delete"    Click="DeleteLoadout_Click"    Width="60" Margin="4,0,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="LoadoutsList" Height="220" Width="300" HorizontalAlignment="Left"
                                     SelectionChanged="LoadoutsList_SelectionChanged"/>
                            <TextBlock x:Name="LoadoutsInfoText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ GENERAL ============================ -->
                    <ScrollViewer x:Name="GeneralPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource ScopeChip}"><TextBlock Style="{StaticResource ScopeChipText}" Text="GLOBAL"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="App-wide basics. Each overlay feature has its own page in the sidebar."/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Startup" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Launch with Windows so a forgotten start never costs you data. On every start the app automatically catches up today's log lines (loot, kills, fights, seen spells — alerts stay quiet for old lines); tray → 'Catch up from today's log' re-runs it any time."/>

                            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows (this exe)" Margin="0,10,0,0"/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Log source" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The newest eqlog_*.txt in the folder is followed — log into another character and the app hops to their file automatically. Your character name is read from that filename."/>

                            <TextBlock Text="Log folder (newest eqlog_*.txt is followed)" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="LogDirBox" Width="440"/>
                                <Button Content="Browse" Click="BrowseLogDir_Click" Width="66" Margin="8,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="File pattern" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FilePatternBox" Width="220" HorizontalAlignment="Left"/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Overlay" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Opacity (0.1 – 1.0, lower = more see-through)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="OpacityBox" Width="120" HorizontalAlignment="Left"/>
                            <CheckBox x:Name="StartLockedCheck" Content="Start locked (game-ready: click-through, no toolbar)"
                                      Margin="0,10,0,0"/>
                            <CheckBox x:Name="MuteCheck" Content="Mute all alerts" Margin="0,6,0,0"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ DATA ============================ -->
                    <ScrollViewer x:Name="DataPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Data" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource ScopeChip}"><TextBlock Style="{StaticResource ScopeChipText}" Text="GLOBAL"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Everything the app knows — loot history, raid kills + drops, Sky progress, seen spells, learned durations — is DERIVED from your log file and stored as JSON in the config folder. These tools rebuild that data from the source."/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Reparse entire log file" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="ADDITIVE: replays the whole followed log (not just today) through loot history, raid kills + their drops, Sky quests, seen spells and duration learning. Run it after an update adds a new log-based feature — history is picked up retroactively. Everything dedupes, so it never double-counts. A typical log takes a few seconds."/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button x:Name="ReparseBtn" Content="⚠ Reparse entire log file" Click="Reparse_Click"
                                        Background="#3A2E14" Foreground="#FFB74D" BorderBrush="#7A5B22"/>
                                <Button x:Name="ReparseOtherBtn" Content="Merge in another log file…" Click="ReparseOther_Click"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="'Merge in another log file…' runs the same replay on a picked file — e.g. a log copied over from a second PC. Same dedupes, so the histories merge safely."/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Reset data files &amp; rebuild" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="DESTRUCTIVE: wipes all the derived data files above, then rebuilds them with a full reparse — a clean slate built purely from what the current log contains. Use it if data ever looks wrong or double-counted. Settings, triggers/loadouts, respawns, raid targets, ★-kept fights and panel positions are never touched."/>
                            <Button x:Name="ResetRebuildBtn" Content="🗑 Reset data files &amp; rebuild from log" Click="ResetRebuild_Click"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Background="#3A1B1E" Foreground="#FF8A80" BorderBrush="#7A2E33"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ BARS & MATRICES ============================ -->
                    <ScrollViewer x:Name="BarsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bars &amp; matrices" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource ScopeChip}"><TextBlock Style="{StaticResource ScopeChipText}" Text="GLOBAL"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Buff/debuff countdown bars and the present/missing cell matrices. The triggers themselves are created under Triggers ('Bars', 'Self buffs', 'Target debuffs')."/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Countdown bars" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Width" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="WidthBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Bar height (thinner bars = lower value)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="BarHeightBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Font size" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FontSizeBox" Width="120" HorizontalAlignment="Left"/>
                            <CheckBox x:Name="ShowHeadersCheck" Content="Show category headers" Margin="0,10,0,0"/>

                            <TextBlock Text="Screen anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="BarsAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Panels stick to their corner and grow away from it — Bottom-left keeps the panel above your hotbar and grows upward."/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Buff / debuff matrices" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The red/green present-missing cell panels. Cell triggers: Triggers → 'Self buffs' or 'Target debuffs'."/>

                            <TextBlock Text="Columns" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MatrixColumnsBox" Width="120" HorizontalAlignment="Left"/>

                            <TextBlock Text="Self-buffs anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SelfAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>

                            <TextBlock Text="Target-debuffs anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TargetAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Rebuff reminders" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Nagging for buffs that dropped: tick 'Remind me when this buff is missing' on a trigger (in the Triggers editor) and a pulsing REBUFF bar + spoken nudge appear once the buff has been seen and is gone. The timings below apply to all of them."/>

                            <TextBlock Text="Warn seconds (bar flashes under this)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="WarnBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Reminder repeat interval (seconds)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RemindBox" Width="120" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ REPOP TIMER ============================ -->
                    <ScrollViewer x:Name="TimerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Repop timer" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource ScopeChip}"><TextBlock Style="{StaticResource ScopeChipText}" Text="GLOBAL"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The circular respawn watch panel. Toggle in game: ☰/tray → Panels, or Ctrl+Alt+R. The mobs it watches live on the Respawns page (KNOWLEDGE)."/>

                            <CheckBox x:Name="TimerVisibleCheck" Content="Visible at startup" Margin="0,12,0,0"/>

                            <TextBlock Text="Screen anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TimerAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ DEATH RECAP ============================ -->
                    <ScrollViewer x:Name="DeathPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Death recap" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource ScopeChip}"><TextBlock Style="{StaticResource ScopeChipText}" Text="GLOBAL"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="When you die, a popup shows the last 15 things that happened to you — hits with attacker and amount, misses dimmed, heals in green — each with the time offset back from the moment of death, and the biggest hit highlighted. Reopen the latest any time: ☰/tray → Death recap…"/>

                            <CheckBox x:Name="DeathRecapCheck" Margin="0,12,0,0"
                                      Content="Pop the recap window automatically when you die"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ RESPAWNS (KNOWLEDGE) ============================ -->
                    <ScrollViewer x:Name="RespawnsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Named respawns" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource ScopeChip}"><TextBlock Style="{StaticResource ScopeChipText}" Text="GLOBAL"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="World knowledge, independent of loadouts: when a mob's death line appears in the log, the repop watch auto-starts with its respawn time (and the mob shows in the watch's ☰ menu). Quick-add in game: the watch's ➕ button."/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="280"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Add" Click="RespawnAdd_Click" Width="52" Margin="0,0,4,0"
                                                AutomationProperties.AutomationId="RespawnAddBtn"/>
                                        <Button Content="Delete" Click="RespawnDelete_Click" Width="60"/>
                                    </StackPanel>
                                    <ListBox x:Name="RespawnList" Height="190"
                                             SelectionChanged="RespawnList_SelectionChanged">
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{StaticResource Brush.TextHint}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Margin="2,5,0,2"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}" Margin="8,0,0,0"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Recent kills" FontWeight="SemiBold" Foreground="#C9D4E3"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="← Add as respawn" Click="RespawnFromDeath_Click"
                                                AutomationProperties.AutomationId="RespawnFromDeathBtn"/>
                                    </StackPanel>
                                    <ListBox x:Name="RecentDeathsList" Height="190"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MouseDoubleClick="RespawnFromDeath_Click"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="The last 10 deaths seen in the log. Pick one, add it, set its respawn time — done."/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="RespawnEditor" IsEnabled="False">
                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" FontWeight="Bold" Margin="0,10,0,0"/>

                                <TextBlock Text="Mob name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"/>

                                <TextBlock Text="Zone (groups the list — filled in automatically)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Zone, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"/>

                                <TextBlock Text="Respawn time" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SecondsText}" Width="120" HorizontalAlignment="Left"
                                         ToolTip="400, 15m, 6m40s or 6:40"/>

                                <TextBlock Text="Death line (regex — optional)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Leave empty to match '&lt;Mob name&gt; has been slain by …' and 'You have slain &lt;Mob name&gt;' automatically."/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ DPS METER (incl. skills section) ============================ -->
                    <ScrollViewer x:Name="MeterPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DPS &amp; Skills" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource ScopeChip}"><TextBlock Style="{StaticResource ScopeChipText}" Text="GLOBAL"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Live rankings with the incoming-damage footer. Fight history, comparisons and raid kills open from the meter's buttons. Character and pet names: General page. Toggle in game: ☰/tray → Panels, or Ctrl+Alt+D."/>

                            <CheckBox x:Name="MeterVisibleCheck" Content="Visible at startup" Margin="0,12,0,0"/>

                            <TextBlock Text="Screen anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="MeterAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Pet" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="A pet name enables the pet damage row here and the pet combat-text lanes. Your own name is auto-detected from the log filename — this is the one name the log can't tell us (yet). A stale value is harmless: it just matches nothing."/>
                            <TextBlock Text="Pet name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PetNameBox" Width="220" HorizontalAlignment="Left"/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Skills section" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="A SKILLS section under the meter — one bar per skill you're grinding: session-wide hits/attempts, hit % and crit %, colored red → amber → green as the land rate climbs. The section's ⟲ button resets the counts."/>

                            <CheckBox x:Name="SkillsVisibleCheck" Content="Show the skills section on the DPS meter" Margin="0,12,0,0"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="290"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Skills to track (comma-separated)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SkillListBox" TextWrapping="Wrap" AcceptsReturn="False"
                                             MinHeight="52" VerticalContentAlignment="Top"
                                             AutomationProperties.AutomationId="SkillListBox"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Easiest: pick from the seen list — it uses the log's exact spelling. Spell resists count as failed attempts."/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                        <TextBlock Text="Seen in your log" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextDim}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="← Track" Click="SkillFromSeen_Click"
                                                AutomationProperties.AutomationId="SkillFromSeenBtn"/>
                                    </StackPanel>
                                    <ListBox x:Name="SeenSkillsList" Height="170"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MouseDoubleClick="SkillFromSeen_Click"/>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="Every ability you've used this session, busiest first ('Catch up from today's log' fills it after a restart). Double-click to track."/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Proc watcher" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="A PROCS section under the meter that fills itself in — any spell effect of yours that lands with no cast behind it (weapon, poison and buff procs), with session counts, procs per minute of active combat, and procs per 100 melee swings. Rates stay blank until there's enough data to be honest. Design borrowed from everquest-companion (MIT)."/>

                            <CheckBox x:Name="ProcsVisibleCheck" Content="Show the proc watcher on the DPS meter" Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ COMBAT TEXT ============================ -->
                    <ScrollViewer x:Name="SctPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Scrolling combat text" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource ScopeChip}"><TextBlock Style="{StaticResource ScopeChipText}" Text="GLOBAL"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Floating numbers in fixed lanes — each lane is its own movable panel (unlock with Ctrl+Alt+L to drag them). Master toggle in game: ⚡ toolbar button, tray, or Ctrl+Alt+C. Pet lanes need a Pet name (General page)."/>

                            <CheckBox x:Name="SctVisibleCheck" Content="Visible at startup" Margin="0,12,0,0"/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Lanes" Style="{StaticResource SectionTitle}"/>

                            <CheckBox x:Name="SctIncomingCheck" Content="Incoming damage (you)" Margin="0,10,0,0"/>
                            <CheckBox x:Name="SctOutgoingCheck" Content="Outgoing damage (you)" Margin="0,6,0,0"/>
                            <CheckBox x:Name="SctHealsCheck" Content="Your heals" Margin="0,6,0,0"/>
                            <CheckBox x:Name="SctHealsInCheck" Content="Heals on you (from others)" Margin="0,6,0,0"/>
                            <CheckBox x:Name="SctPetInCheck" Content="Pet incoming damage" Margin="0,6,0,0"/>
                            <CheckBox x:Name="SctPetOutCheck" Content="Pet outgoing damage" Margin="0,6,0,0"/>
                            <CheckBox x:Name="SctProgressCheck" Content="XP, faction hits &amp; AA points" Margin="0,6,0,0"/>

                            <Border Style="{StaticResource PageSep}"/>
                            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Number size" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SctFontBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Big-hit threshold (hits at/above render larger)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SctBigHitBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Lane width" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SctLaneWidthBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Lane height" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SctLaneHeightBox" Width="120" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ============================ FLASH ALERTS ============================ -->
                    <ScrollViewer x:Name="FlashPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Flash alerts" Style="{StaticResource PageTitle}"/>
                                <Border Style="{StaticResource ScopeChip}"><TextBlock Style="{StaticResource ScopeChipText}" Text="GLOBAL"/></Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The screen-flash area. Flash triggers (and per-trigger flash text) are created under Triggers. Unlock the overlay (Ctrl+Alt+L) to see and drag the area."/>

                            <CheckBox x:Name="FlashVisibleCheck" Content="Show flash alerts" Margin="0,12,0,0"/>

                            <TextBlock Text="Flash text size" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FlashFontBox" Width="120" HorizontalAlignment="Left"/>
                            <TextBlock Text="Flash area width (text wraps inside)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="FlashWidthBox" Width="120" HorizontalAlignment="Left"/>

                            <TextBlock Text="Screen anchor" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="FlashAnchorBox" Width="200" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Top-left"     Tag="TopLeft"/>
                                <ComboBoxItem Content="Top-right"    Tag="TopRight"/>
                                <ComboBoxItem Content="Bottom-left"  Tag="BottomLeft"/>
                                <ComboBoxItem Content="Bottom-right" Tag="BottomRight"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ShortcutsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource PageTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,12"
                                       Text="Global hotkeys — they work even while the game has focus."/>

                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style x:Key="KeyBadge" TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="CornerRadius" Value="4"/>
                                        <Setter Property="Padding" Value="8,3"/>
                                        <Setter Property="Width" Value="110"/>
                                        <Setter Property="Margin" Value="0,0,10,6"/>
                                    </Style>
                                    <Style x:Key="KeyText" TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                    <Style x:Key="KeyDesc" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                    </Style>
                                </StackPanel.Resources>

                                <DockPanel><Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl+Alt+L"/></Border><TextBlock Style="{StaticResource KeyDesc}" Text="Lock / unlock all panels (click-through when locked)"/></DockPanel>
                                <DockPanel><Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl+Alt+H"/></Border><TextBlock Style="{StaticResource KeyDesc}" Text="Hide / show the whole overlay"/></DockPanel>
                                <DockPanel><Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl+Alt+S"/></Border><TextBlock Style="{StaticResource KeyDesc}" Text="Mute / unmute all sound and spoken alerts"/></DockPanel>
                                <DockPanel><Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl+Alt+R"/></Border><TextBlock Style="{StaticResource KeyDesc}" Text="Show / hide the repop timer"/></DockPanel>
                                <DockPanel><Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl+Alt+D"/></Border><TextBlock Style="{StaticResource KeyDesc}" Text="Show / hide the DPS meter"/></DockPanel>
                                <DockPanel><Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl+Alt+C"/></Border><TextBlock Style="{StaticResource KeyDesc}" Text="Show / hide scrolling combat text"/></DockPanel>
                                <DockPanel><Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl+Alt+T"/></Border><TextBlock Style="{StaticResource KeyDesc}" Text="Test — demo bars, combat text floats and a flash"/></DockPanel>
                                <DockPanel><Border Style="{StaticResource KeyBadge}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl+Alt+Q"/></Border><TextBlock Style="{StaticResource KeyDesc}" Text="Quit EQL Assistant"/></DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
