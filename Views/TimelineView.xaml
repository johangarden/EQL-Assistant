<UserControl x:Class="EQLOverlay.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <!-- StaticResource resolves at parse time, BEFORE this control joins its
         window's tree — the theme must be merged here, not inherited. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The fight report, Johan's three bands: highlights up top, the offence
         and defence timelines in the middle (built in code into BoardsHost),
         and the per-ability tables live below in the History window itself. -->
    <StackPanel>
        <TextBlock x:Name="TitleText" Foreground="#E8EEF7" FontWeight="Bold" FontSize="16"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Hint}" Margin="0,1,0,0"
                   TextWrapping="Wrap"/>
        <WrapPanel x:Name="ChipsPanel" Margin="0,6,0,0"/>

        <!-- Three highlight rows (built in code): the fight's totals, who
             dealt it, and what hit you. -->
        <StackPanel x:Name="TilesPanel" Margin="0,8,0,0"/>

        <!-- ⚡ analysis, split by mindset: a player asks one question at a time. -->
        <Grid x:Name="AnalysisHost" Visibility="Collapsed" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Margin="0,0,5,0" Background="#10182A"
                    BorderBrush="#2A3A5C" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="⚔ OFFENCE" Foreground="#FFC12E" FontWeight="Bold"
                               FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock x:Name="OffAnalysisText" Foreground="{StaticResource Brush.TextDim}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="5,0,0,0" Background="#10182A"
                    BorderBrush="#2A3A5C" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="🛡 DEFENCE" Foreground="#FF8A80" FontWeight="Bold"
                               FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DefAnalysisText" Foreground="{StaticResource Brush.TextDim}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel x:Name="BoardsHost" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
