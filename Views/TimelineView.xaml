<UserControl x:Class="EQLOverlay.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <!-- StaticResource resolves at parse time, BEFORE this control joins its
         window's tree — the theme must be merged here, not inherited. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,2">
            <Button DockPanel.Dock="Right" Content="⚡ Analyse fight" Width="120"
                    Style="{StaticResource PrimaryBtn}" Click="Analyse_Click"
                    VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock x:Name="TitleText" Foreground="#C9D4E3" FontWeight="Bold" FontSize="13"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SubtitleText" Style="{StaticResource Hint}" Margin="0,1,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- On-demand analysis: rules over this fight's own numbers. -->
        <Border x:Name="AnalysisPanel" Visibility="Collapsed" Background="#10182A"
                BorderBrush="#2A3A5C" BorderThickness="1" CornerRadius="6"
                Padding="10,8" Margin="0,6,0,2">
            <TextBlock x:Name="AnalysisText" Foreground="{StaticResource Brush.TextDim}"
                       FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Time axis; left margin matches the lane label column. -->
        <Canvas x:Name="AxisCanvas" Height="18" Margin="150,6,0,3" ClipToBounds="True"/>

        <!-- Rolling-DPS graph, sharing the lanes' time axis. -->
        <StackPanel x:Name="GraphHost" Visibility="Collapsed">
            <DockPanel Margin="150,2,0,2">
                <TextBlock x:Name="PeakText" DockPanel.Dock="Right" Foreground="#5C6B82" FontSize="10"/>
                <StackPanel x:Name="LegendPanel" Orientation="Horizontal"/>
            </DockPanel>
            <Border Margin="150,0,0,8" Background="#10FFFFFF" CornerRadius="4"
                    HorizontalAlignment="Left">
                <Canvas x:Name="GraphCanvas" Height="120" ClipToBounds="True"/>
            </Border>
        </StackPanel>

        <StackPanel x:Name="LanesHost"/>
    </StackPanel>
</UserControl>
