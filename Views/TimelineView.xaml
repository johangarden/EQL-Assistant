<UserControl x:Class="EQLOverlay.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <!-- StaticResource resolves at parse time, BEFORE this control joins its
         window's tree — the theme must be merged here, not inherited. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The fight report, Johan's three bands: highlights up top, the offence
         and defence timelines in the middle (built in code into BoardsHost),
         and the per-ability tables live below in the History window itself. -->
    <StackPanel>
        <TextBlock x:Name="TitleText" Foreground="#E8EEF7" FontWeight="Bold" FontSize="16"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Hint}" Margin="0,1,0,0"
                   TextWrapping="Wrap"/>
        <WrapPanel x:Name="ChipsPanel" Margin="0,6,0,0"/>
        <WrapPanel x:Name="TilesPanel" Margin="0,8,0,0"/>

        <!-- ⚡ analysis: rules over this fight's own numbers, run on visit. -->
        <Border x:Name="AnalysisPanel" Visibility="Collapsed" Background="#10182A"
                BorderBrush="#2A3A5C" BorderThickness="1" CornerRadius="6"
                Padding="10,8" Margin="0,8,0,0">
            <TextBlock x:Name="AnalysisText" Foreground="{StaticResource Brush.TextDim}"
                       FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <StackPanel x:Name="BoardsHost" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
