<Window x:Class="EQLOverlay.Views.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- The app's command strip: always visible and clickable, locked or not.
         The padlock governs the OTHER panels; hide this one via ☰/tray → Panels.
         One row, three zones: app · features · state — the cog (settings mode)
         stands alone behind its own separator. -->
    <StackPanel>
        <Border Background="#E01B2130" CornerRadius="5" Padding="8,5" Width="384"
                MouseLeftButtonDown="Root_DragMove">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Content="✕" Click="OnQuit" Style="{StaticResource CloseBtn}"
                        ToolTip="Quit EQL Assistant"/>

                <!-- settings mode, isolated at the far end -->
                <Button DockPanel.Dock="Right" Click="OnManage" Style="{StaticResource IconBtn}"
                        Margin="6,0,0,0" FontFamily="Segoe MDL2 Assets" Content="&#xE713;"
                        AutomationProperties.AutomationId="ManageBtn"
                        ToolTip="Manage settings — triggers, panels, everything"/>
                <Border DockPanel.Dock="Right" Width="1" Height="18" Background="#3A4560" Margin="6,0,0,0"/>

                <Button DockPanel.Dock="Right" Click="OnLock" Margin="6,0,0,0"
                        FontFamily="Segoe MDL2 Assets"
                        AutomationProperties.AutomationId="LockBtn"
                        ToolTip="Lock / unlock all panels (Ctrl+Alt+L)">
                    <Button.Style>
                        <!-- The glyph mirrors the CURRENT state: closed lock when
                             locked, open lock when unlocked — with an accent CTA
                             background reminding you to lock before playing. -->
                        <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                            <Setter Property="Content" Value="&#xE72E;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                    <Setter Property="Content" Value="&#xE785;"/>
                                    <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button DockPanel.Dock="Right" Click="OnMute" Margin="6,0,0,0"
                        FontFamily="Segoe MDL2 Assets"
                        AutomationProperties.AutomationId="MuteBtn"
                        ToolTip="Mute / unmute alerts (Ctrl+Alt+S)">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                            <Setter Property="Content" Value="&#xE767;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Muted}" Value="True">
                                    <Setter Property="Content" Value="&#xE74F;"/>
                                    <Setter Property="Foreground" Value="#FFB74D"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button DockPanel.Dock="Right" Click="OnMenu" Style="{StaticResource IconBtn}"
                        Margin="6,0,0,0" FontFamily="Segoe MDL2 Assets" Content="&#xE700;"
                        AutomationProperties.AutomationId="MainMenuBtn"
                        ToolTip="Menu — panel toggles, loadouts, show/hide, catch-up"/>

                <Border DockPanel.Dock="Right" Width="1" Height="18" Background="#3A4560" Margin="6,0,0,0"/>

                <!-- feature shortcuts: the play-time windows, one click each -->
                <Button DockPanel.Dock="Right" Click="OnLoot" Style="{StaticResource IconBtn}"
                        Margin="6,0,0,0" AutomationProperties.AutomationId="LootBtn"
                        ToolTip="Loot history — upgrades, kept items, vendor income">
                    <!-- A leather loot sack: tuft, cinch band, round body —
                         chunky enough to survive 14px. -->
                    <Path Fill="#C68B4F" Width="14" Height="14" Stretch="Uniform"
                          Data="M10 2.2 Q12 0.8 14 2.2 L13.2 4.4 L10.8 4.4 Z M9.6 5 L14.4 5 L14.4 6.6 L9.6 6.6 Z M12 7.2 C7 9 4.8 13 4.8 16.4 C4.8 20.4 8.2 22 12 22 C15.8 22 19.2 20.4 19.2 16.4 C19.2 13 17 9 12 7.2 Z"/>
                </Button>
                <Button DockPanel.Dock="Right" Click="OnQuests" Style="{StaticResource IconBtn}"
                        Margin="6,0,0,0" AutomationProperties.AutomationId="QuestsBtn"
                        ToolTip="Quests — tracking, droppers and turn-in progress">
                    <!-- The classic quest-giver "!": a tapered bar + dot, in
                         the quest-giver's own bright yellow. -->
                    <Path Fill="#FFD100" Width="14" Height="14" Stretch="Uniform"
                          Data="M9.6 2 L14.4 2 L13.3 15 L10.7 15 Z M12 17.4 A2.4 2.4 0 1 0 12 22.2 A2.4 2.4 0 1 0 12 17.4 Z"/>
                </Button>
                <Button DockPanel.Dock="Right" Click="OnRaid" Style="{StaticResource IconBtn}"
                        Margin="6,0,0,0" AutomationProperties.AutomationId="RaidBtn"
                        ToolTip="Raid kills — targets, weekly lockout, drops">
                    <!-- a war banner, the raid-target flag: pole + swallow-tailed
                         pennant — crossed swords read as a close-X at 14px, and
                         the skull before them sat head-to-head with the helm. -->
                    <Path Fill="#E57373" Width="14" Height="14" Stretch="Uniform"
                          Data="F1 M5.2 2 L7 2 L7 22 L5.2 22 Z M7 3.4 L20.8 3.4 L16.6 8.2 L20.8 13 L7 13 Z"/>
                </Button>

                <!-- the Character window: paper-doll, all items, exaltations,
                     focus board — one window, the helm is its door -->
                <Button DockPanel.Dock="Right" Click="OnSheet" Style="{StaticResource IconBtn}"
                        Margin="6,0,0,0" AutomationProperties.AutomationId="SheetBtn"
                        ToolTip="Character — sheet, all items, exaltations and the focus board">
                    <!-- a knight's great helm in steel: dome, eye slits either
                         side of the nose bar, breath slit (EvenOdd holes) -->
                    <Path Fill="#AEB8C4" Width="14" Height="14" Stretch="Uniform"
                          Data="M12 2.5 C6.8 2.5 4.5 6.5 4.5 11 L4.5 21.5 L19.5 21.5 L19.5 11 C19.5 6.5 17.2 2.5 12 2.5 Z M6.8 9.6 L11.2 9.6 L11.2 11.4 L6.8 11.4 Z M12.8 9.6 L17.2 9.6 L17.2 11.4 L12.8 11.4 Z M11.2 13.4 L12.8 13.4 L12.8 18.6 L11.2 18.6 Z"/>
                </Button>

                <!-- fill: the active loadout's NAME only, kept short — switching
                     lives in the ☰ menu's Loadout submenu (one picker is enough). -->
                <TextBlock Text="{Binding LoadoutName}" Foreground="#6E7C93" FontSize="10"
                           VerticalAlignment="Center" Margin="8,0,6,0" MaxWidth="86"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding LoadoutName}"/>
            </DockPanel>
        </Border>

        <!-- Toast: short-lived confirmations ("Switched to: Raid", "Pet
             detected: Lober") — fades after ~4s instead of a permanent line. -->
        <Border Background="#E01B2130" CornerRadius="5" Padding="9,4" Margin="0,4,0,0"
                HorizontalAlignment="Left" MaxWidth="384"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Toast}" Foreground="#C9D4E3" FontSize="11" TextWrapping="Wrap"/>
        </Border>
    </StackPanel>
</Window>
