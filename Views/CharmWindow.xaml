<Window x:Class="EQLOverlay.Views.CharmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- The charm card (owner request 14 Sep, mocked first): one pet — chip,
         name, age; the spell; a bar that counts UP to the library ceiling;
         what the pet dealt; red when the charm broke, amber while attempts
         fail. Hidden when locked and there is nothing to say. -->
    <Border x:Name="RootBorder" CornerRadius="8" Padding="12,10,12,11" Background="#E0141A24"
            BorderBrush="#3A4560" BorderThickness="1" Width="300">
        <StackPanel>
            <DockPanel x:Name="HeaderRow" MouseLeftButtonDown="Header_DragMove" Background="Transparent">
                <Border x:Name="ChipBox" DockPanel.Dock="Left" Padding="7,1,7,2" CornerRadius="4"
                        Background="#2A3350" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="ChipText" Text="CHARM" FontSize="10" FontWeight="Bold" Foreground="#B39DDB"/>
                </Border>
                <TextBlock x:Name="AgeText" DockPanel.Dock="Right" FontSize="13" FontWeight="Bold" Foreground="#FFD54F"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="PetText" FontSize="12.5" FontWeight="SemiBold" Foreground="#C9D4E3"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock x:Name="SpellText" FontSize="11" Foreground="#7F93AD" Margin="0,2,0,0"/>

            <TextBlock x:Name="Placeholder" Foreground="#5C6B82" FontSize="12" Margin="0,8,0,2"
                       HorizontalAlignment="Center" Visibility="Collapsed"
                       Text="Your charmed pet shows here — from the charm landing to its break."/>

            <StackPanel x:Name="Body">
                <Grid x:Name="TrackRow" Height="8" Margin="0,8,0,6">
                    <Border Background="#0F141E" CornerRadius="4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FillCol" Width="0*"/>
                            <ColumnDefinition x:Name="RestCol" Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="FillBar" Background="#9575CD" CornerRadius="4"/>
                    </Grid>
                </Grid>
                <DockPanel x:Name="MetaRow">
                    <TextBlock x:Name="CeilingText" DockPanel.Dock="Right" FontSize="11" Foreground="#7F93AD"/>
                    <TextBlock x:Name="HeldText" FontSize="11" Foreground="#7F93AD"/>
                </DockPanel>
                <Grid x:Name="StatsRow" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DealtText" Grid.Column="0" FontSize="11" Foreground="#7F93AD"/>
                    <TextBlock x:Name="KillsText" Grid.Column="1" FontSize="11" Foreground="#7F93AD" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LastHitText" Grid.Column="2" FontSize="11" Foreground="#7F93AD" HorizontalAlignment="Right"/>
                </Grid>
                <!-- The pet's pace this charm, and what this mob did for you before. -->
                <TextBlock x:Name="PaceText" FontSize="11" Foreground="#7F93AD" Margin="0,2,0,0"/>
                <TextBlock x:Name="HistoryText" FontSize="11" Foreground="#5C6B82" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <Border x:Name="VerdictBox" CornerRadius="5" Padding="8,6" BorderThickness="1" Margin="0,8,0,0"
                        BorderBrush="#7A2E33" Background="#2A1416" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="VerdictTitle" FontSize="14" FontWeight="Bold" Foreground="#FF8A80"/>
                        <TextBlock x:Name="VerdictText" FontSize="11.5" Foreground="#F5C6C2" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
