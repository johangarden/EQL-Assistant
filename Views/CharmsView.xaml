<UserControl x:Class="EQLOverlay.Views.CharmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Charmed pets (owner, 21 Sep): the charm ledger per mob, then the
         recent charms one by one. Sits in the Character window. -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Foreground="#7F93AD" FontSize="11"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="SearchBox" TextChanged="Search_Changed" ToolTip="Filter by mob, zone or charm spell"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="BY MOB" Foreground="#5C6B82" FontSize="9.5" FontWeight="Bold" Margin="2,0,0,4"/>
                <StackPanel x:Name="MobsHost"/>
                <TextBlock Text="RECENT CHARMS" Foreground="#5C6B82" FontSize="9.5" FontWeight="Bold" Margin="2,16,0,4"/>
                <StackPanel x:Name="RecentHost"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
