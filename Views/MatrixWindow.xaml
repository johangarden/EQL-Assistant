<Window x:Class="EQLOverlay.Views.MatrixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EQLOverlay.ViewModels"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- One present/missing cell: maroon when missing, green when active (+ seconds). -->
        <DataTemplate x:Key="CellTemplate" DataType="{x:Type vm:MatrixCellViewModel}">
            <Border x:Name="CellBox" Width="68" Height="42" Margin="3" CornerRadius="5"
                    Background="#4A2530" BorderBrush="#5A3540" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Foreground="#E2E6EC" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="62"/>
                    <TextBlock Text="{Binding RemainingText}" Foreground="White" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.7" Color="Black"/>
                </Border.Effect>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="CellBox" Property="Background" Value="#1F6B2E"/>
                    <Setter TargetName="CellBox" Property="BorderBrush" Value="#3FA85A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter TargetName="CellBox" Property="BorderBrush" Value="#FFB74D"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="6" Padding="6" Background="Transparent">
        <StackPanel>
            <!-- Drag handle + title, shown only when unlocked. -->
            <Border x:Name="Header" Background="#E01B2130" CornerRadius="5" Padding="8,3" Margin="0,0,0,4"
                    Visibility="Collapsed" MouseLeftButtonDown="Header_DragMove">
                <TextBlock x:Name="HeaderText" Text="Panel" Foreground="#9FB4D0" FontWeight="Bold" FontSize="11"/>
            </Border>

            <ItemsControl x:Name="CellsControl" ItemTemplate="{StaticResource CellTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
