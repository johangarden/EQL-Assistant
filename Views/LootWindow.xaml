<Window x:Class="EQLOverlay.Views.LootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:EQLOverlay.Views"
        Title="EQL Assistant — Loot History"
        Width="900" Height="620"
        MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Foreground="{StaticResource Brush.Gold}"
                           FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="Loot history" Style="{StaticResource PageTitle}"/>
            </DockPanel>

            <!-- The sub-views (owner ruling, 2 Sep): the parent window owns
                 the domain, pills pick the lens. -->
            <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                <Border x:Name="DropPill" CornerRadius="14" BorderThickness="1" Padding="15,4"
                        Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="View_Click" Tag="drops">
                    <TextBlock Text="Drop log" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="MotePill" CornerRadius="14" BorderThickness="1" Padding="15,4"
                        Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="View_Click" Tag="motes"
                        ToolTip="Where an hour of farming actually pays — mote rates per zone and tier, mined from this loot ledger">
                    <TextBlock Text="Mote farming" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <!-- The item browser (moved here from the Character window,
                     owner ruling 2 Sep): what you OWN, per the inventory dump. -->
                <Border x:Name="ItemsPill" CornerRadius="14" BorderThickness="1" Padding="15,4"
                        Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="View_Click" Tag="items"
                        ToolTip="Every item you own, per the game's inventory dump — worn, bags, bank, depot, hoard">
                    <TextBlock Text="All items" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="ExaltPill" CornerRadius="14" BorderThickness="1" Padding="15,4"
                        Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="View_Click" Tag="exalt"
                        ToolTip="Your exaltations and their sockets">
                    <TextBlock Text="Exaltations" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="SetsPill" CornerRadius="14" BorderThickness="1" Padding="15,4"
                        Cursor="Hand" MouseLeftButtonDown="View_Click" Tag="sets"
                        ToolTip="Planar class armor sets — which pieces you hold, which you're missing">
                    <TextBlock Text="Armor sets" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <TextBlock x:Name="HintText" Style="{StaticResource Hint}" Margin="0,0,0,8"
                       Text="Every item looted, from the log: upgrades applied to your gear, items kept in your bags, and auto-vendored drops with what they sold for."/>

            <DockPanel x:Name="FiltersRow" Margin="0,0,0,8">
                <ComboBox x:Name="KindBox" DockPanel.Dock="Right" Width="130" Margin="8,0,0,0"
                          SelectionChanged="Filters_Changed" SelectedValuePath="Tag">
                    <ComboBoxItem Content="Everything" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="Upgrades" Tag="Upgrade"/>
                    <ComboBoxItem Content="Kept" Tag="Kept"/>
                    <ComboBoxItem Content="Vendored" Tag="Sold"/>
                </ComboBox>
                <TextBox x:Name="SearchBox" TextChanged="Filters_Changed"
                         AutomationProperties.AutomationId="LootSearchBox"
                         ToolTip="Search item, mob or zone"/>
            </DockPanel>

            <!-- Mote view: the grade lens + strictness pills (built in code) -->
            <WrapPanel x:Name="GradePills" Margin="0,0,0,4" Visibility="Collapsed"/>
            <WrapPanel x:Name="TimePills" Margin="0,0,0,8" Visibility="Collapsed"/>
        </StackPanel>

        <Grid>
            <ListBox x:Name="ResultsList"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,3">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}"
                                       Foreground="{Binding ValueBrush}" FontWeight="SemiBold" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Item}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Brush.TextHint}"
                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer x:Name="MoteScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel x:Name="MoteVerdicts" Margin="0,0,0,10"/>
                    <Grid x:Name="MoteTableHost" VerticalAlignment="Top"/>
                </StackPanel>
            </ScrollViewer>

            <!-- The inventory panel's browser tabs (All items · Exaltations ·
                 Armor sets), driven by the pills above; its own tab row hides. -->
            <v:InventoryPanel x:Name="ItemsPanel" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
