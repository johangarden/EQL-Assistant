<Window x:Class="EQLOverlay.Views.CharacterSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Character sheet"
        Width="980" Height="720"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- footer: Level · classes · /who age (the session panel's machinery) -->
        <Border DockPanel.Dock="Bottom" Background="#10151D" BorderBrush="#3A4560" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,8,16,9">
                <TextBlock x:Name="FootWho" DockPanel.Dock="Right" Foreground="#5C6B82" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="FootClasses" Foreground="#7F93AD" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Name="FootLevel" DockPanel.Dock="Left" Foreground="#C9D4E3" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
            </DockPanel>
        </Border>

        <DockPanel Margin="14,12,14,10">
            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,10">
                <TextBlock x:Name="FocusSummary" DockPanel.Dock="Right" Foreground="#5C6B82" FontSize="11"
                           VerticalAlignment="Center"
                           ToolTip="The focus audit's score — the Inventory's Focus effects tab holds the full board"/>
                <TextBlock x:Name="CharName" Style="{StaticResource PageTitle}"/>
            </DockPanel>

            <!-- Shown instead of the sheet until a dump exists. -->
            <TextBlock x:Name="NoDumpText" Style="{StaticResource Hint}" Visibility="Collapsed"
                       Margin="4,10,4,0" TextWrapping="Wrap"
                       Text="No inventory dump found yet — the sheet reads the game's /outputfile inventory dump. Open the Inventory window (the chest on the toolbar) for the how-to."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- the doll: anatomical rows, built in code -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DollRows"/>
                </ScrollViewer>

                <!-- detail pane -->
                <Border Grid.Column="2" Background="#1A2230" BorderBrush="#232C3E" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" VerticalAlignment="Top">
                    <StackPanel>
                        <WrapPanel x:Name="PaneTabs" Margin="0,0,0,10"/>
                        <DockPanel>
                            <!-- the wiki's own 40×40 item art, when the table has it -->
                            <Image x:Name="PaneIcon" DockPanel.Dock="Left" Width="34" Height="34"
                                   Margin="0,1,9,0" VerticalAlignment="Top" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="Fant"/>
                            <StackPanel>
                                <TextBlock x:Name="PaneTitle" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PaneSub" Foreground="#5C6B82" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="10"/>
                        <ItemsControl x:Name="PaneLines">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,7">
                                        <TextBlock Text="{Binding Key}" Foreground="#5C6B82" FontSize="9.5"
                                                   FontWeight="Bold" Visibility="{Binding KeyVis}"/>
                                        <TextBlock Text="{Binding Value}" Foreground="{Binding Fg}" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PaneHint" Foreground="#7F93AD" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
