<Window x:Class="EQLOverlay.Views.CharacterSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Character sheet"
        Width="1200" Height="864"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <DockPanel Margin="14,12,14,10">
            <!-- header: name · server · level + age · class chips ·
                 stated-by chip (the session panel's ding//who machinery) -->
            <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                <TextBlock x:Name="FocusSummary" DockPanel.Dock="Right" Foreground="#5C6B82" FontSize="11"
                           VerticalAlignment="Center"
                           ToolTip="The focus audit's score — the Inventory's Focus effects tab holds the full board"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CharName" Style="{StaticResource PageTitle}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ServerText" Foreground="#5C6B82" FontSize="11"
                               VerticalAlignment="Center" Margin="9,5,0,0"/>
                    <TextBlock x:Name="LevelText" Foreground="#C9D4E3" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,2,0,0"/>
                    <TextBlock x:Name="LevelAge" Foreground="#5C6B82" FontSize="10.5"
                               VerticalAlignment="Center" Margin="6,4,0,0"/>
                    <StackPanel x:Name="ClassChips" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,2,0,0"/>
                    <TextBlock x:Name="WhoHint" Foreground="#5C6B82" FontSize="10.5"
                               VerticalAlignment="Center" Margin="12,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- the dump strip: what feeds this sheet, and how stale it is -->
            <Border x:Name="DumpStrip" DockPanel.Dock="Top" Background="#10151D" BorderBrush="#232C3E"
                    BorderThickness="1" CornerRadius="7" Padding="12,6,12,7" Margin="2,0,2,10"
                    Visibility="Collapsed">
                <DockPanel>
                    <TextBlock x:Name="DumpAge" DockPanel.Dock="Right" Foreground="#5C6B82" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="DumpHow" DockPanel.Dock="Right" Text="HOW" Foreground="#E8C15A"
                               FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                               ToolTipService.ShowDuration="30000"/>
                    <TextBlock VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis">
                        <Run Text="/outputfile inventory" FontFamily="Consolas" FontWeight="Bold" Foreground="#C9D4E3"/>
                        <Run Text="  Re-type it in game whenever your gear changes — the sheet follows the dump."
                             Foreground="#7F93AD"/>
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Shown instead of the sheet until a dump exists. -->
            <TextBlock x:Name="NoDumpText" Style="{StaticResource Hint}" Visibility="Collapsed"
                       Margin="4,10,4,0" TextWrapping="Wrap"
                       Text="No inventory dump found yet — the sheet reads the game's /outputfile inventory dump. Open the Inventory window (the chest on the toolbar) for the how-to."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- the doll: anatomical rows, built in code -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DollRows"/>
                </ScrollViewer>

                <!-- detail pane -->
                <Border Grid.Column="2" Background="#1A2230" BorderBrush="#232C3E" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" VerticalAlignment="Top">
                    <StackPanel>
                        <WrapPanel x:Name="PaneTabs" Margin="0,0,0,10"/>
                        <DockPanel>
                            <!-- the wiki's own 40×40 item art, when the table has it -->
                            <Image x:Name="PaneIcon" DockPanel.Dock="Left" Width="34" Height="34"
                                   Margin="0,1,9,0" VerticalAlignment="Top" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="Fant"/>
                            <StackPanel>
                                <TextBlock x:Name="PaneTitle" FontWeight="SemiBold" FontSize="14"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PaneSub" Foreground="#5C6B82" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Height="10"/>
                        <ItemsControl x:Name="PaneLines">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,7">
                                        <TextBlock Text="{Binding Key}" Foreground="#5C6B82" FontSize="9.5"
                                                   FontWeight="Bold" Visibility="{Binding KeyVis}"/>
                                        <TextBlock Text="{Binding Value}" Foreground="{Binding Fg}" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- the Stats tab's item-window grid (label: value columns) -->
                        <ContentControl x:Name="PaneGrid" Visibility="Collapsed" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="PaneLinesBelow" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,7">
                                        <TextBlock Text="{Binding Key}" Foreground="#5C6B82" FontSize="9.5"
                                                   FontWeight="Bold" Visibility="{Binding KeyVis}"/>
                                        <TextBlock Text="{Binding Value}" Foreground="{Binding Fg}" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PaneHint" Foreground="#7F93AD" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
