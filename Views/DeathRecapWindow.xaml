<Window x:Class="EQLOverlay.Views.DeathRecapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Death Recap"
        Width="540" Height="600"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowActivated="False"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource Brush.TextBlue}"
                       FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <!-- The story of the death: the killing burst named outright,
                 or "worn down" when there wasn't one. -->
            <Border x:Name="StoryBorder" BorderThickness="3,0,0,0" BorderBrush="#B23B3B"
                    Padding="10,2,0,2" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="StoryText" Foreground="{StaticResource Brush.TextDim}"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- The death graph: one column per second, damage down / healing up,
             the zero axis through the middle. Hover a column for its events. -->
        <StackPanel x:Name="GraphSection" DockPanel.Dock="Top" Margin="0,2,0,10">
            <Grid>
                <UniformGrid x:Name="GraphGrid" Rows="1"/>
                <Border Height="1" Background="#3A4560" VerticalAlignment="Center"
                        IsHitTestVisible="False"/>
            </Grid>
            <UniformGrid x:Name="AxisGrid" Rows="1" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border Width="8" Height="8" CornerRadius="2" Background="#E57373" VerticalAlignment="Center"/>
                <TextBlock Text="damage / s" Foreground="{StaticResource Brush.TextFaint}"
                           FontSize="10" Margin="4,0,14,0" VerticalAlignment="Center"/>
                <Border Width="8" Height="8" CornerRadius="2" Background="#81C784" VerticalAlignment="Center"/>
                <TextBlock Text="healing / s" Foreground="{StaticResource Brush.TextFaint}"
                           FontSize="10" Margin="4,0,14,0" VerticalAlignment="Center"/>
                <Border x:Name="BurstLegendChip" Width="8" Height="8" CornerRadius="2"
                        Background="#FF5A50" VerticalAlignment="Center"/>
                <TextBlock x:Name="BurstLegendText" Text="the killing burst"
                           Foreground="{StaticResource Brush.TextFaint}"
                           FontSize="10" Margin="4,0,14,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="PeakText" Foreground="{StaticResource Brush.TextFaint}"
                           FontSize="10" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Swings that missed: collapsed to chips, they never eat rows. -->
        <StackPanel x:Name="MissSection" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                    Visibility="Collapsed">
            <TextBlock Text="SWINGS THAT MISSED" Foreground="{StaticResource Brush.TextFaint}"
                       FontSize="9" FontWeight="Bold" Margin="1,0,0,4"/>
            <ItemsControl x:Name="MissChips">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1B2130" BorderBrush="#3A4560" BorderThickness="1"
                                CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                            <TextBlock Text="{Binding}" Foreground="{StaticResource Brush.TextDim}"
                                       FontSize="11"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- The grouped ledger: repeats merge into ×N rows, oldest first. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RowsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,4" CornerRadius="4" Margin="0,1"
                                Background="{Binding RowBg}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding T}" Width="52"
                                           Foreground="{StaticResource Brush.TextFaint}"
                                           FontFamily="Consolas" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}"
                                           Foreground="{Binding AmountBrush}" FontWeight="Bold"
                                           FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
