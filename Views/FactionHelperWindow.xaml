<Window x:Class="EQLOverlay.Views.FactionHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- The faction helper (owner, 22 Sep): a HUD card like the quest
         droppers — appears when a faction line moves a race you ★ track on
         the Character window's Races tab, fades 20 s after the last one. -->
    <Border x:Name="RootBorder" CornerRadius="8" Padding="10,8,10,10" Background="#E0141A24"
            BorderBrush="#3A4560" BorderThickness="1" Width="320">
        <StackPanel>
            <Border x:Name="Header" Background="#E01B2130" CornerRadius="5" Padding="8,3" Margin="0,0,0,6"
                    Visibility="Collapsed" MouseLeftButtonDown="Header_DragMove">
                <TextBlock Text="Faction helper — hits on the races you ★ track" Foreground="#9FB4D0" FontWeight="Bold" FontSize="11"/>
            </Border>
            <TextBlock x:Name="Placeholder" Foreground="#7F93AD" FontSize="11" Margin="2,2,2,4" Visibility="Collapsed"
                       MaxWidth="296" TextWrapping="Wrap"
                       Text="★ a race on the Character window's Races tab. Each faction hit that moves it shows here — standing, points to max, the mob and how many more like it."/>
            <StackPanel x:Name="Body"/>
        </StackPanel>
    </Border>
</Window>
