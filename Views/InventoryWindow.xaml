<Window x:Class="EQLOverlay.Views.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:EQLOverlay.Views"
        Title="EQL Assistant — Character"
        Width="1200" Height="940"
        MinWidth="1170" MinHeight="940" MaxHeight="940"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The Character window: the analysis tabs of the inventory panel
         (Sheet · Focus board · Best in slot). The browser tabs live in the
         Loot window (owner ruling, 2 Sep). -->
    <v:InventoryPanel x:Name="Panel" Margin="12"/>
</Window>
