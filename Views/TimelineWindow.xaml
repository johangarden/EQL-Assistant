<Window x:Class="EQLOverlay.Views.TimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Fight Timeline"
        Width="940" Height="620"
        MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="⚡ Analyse fight" Width="120"
                        Style="{StaticResource PrimaryBtn}" Click="Analyse_Click"
                        VerticalAlignment="Top"/>
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Hint}" Margin="0,2,0,8"/>

            <!-- On-demand analysis: rules over this fight's own numbers. -->
            <Border x:Name="AnalysisPanel" Visibility="Collapsed" Background="#10182A"
                    BorderBrush="#2A3A5C" BorderThickness="1" CornerRadius="6"
                    Padding="10,8" Margin="0,0,0,8">
                <TextBlock x:Name="AnalysisText" Foreground="{StaticResource Brush.TextDim}"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>
            <!-- Time axis; left margin matches the lane label column, right the scrollbar. -->
            <Canvas x:Name="AxisCanvas" Height="18" Margin="150,0,11,3" ClipToBounds="True"/>

            <!-- Rolling-DPS graph, sharing the lanes' time axis. -->
            <StackPanel x:Name="GraphHost" Visibility="Collapsed">
                <DockPanel Margin="150,2,11,2">
                    <TextBlock x:Name="PeakText" DockPanel.Dock="Right" Foreground="#5C6B82" FontSize="10"/>
                    <StackPanel x:Name="LegendPanel" Orientation="Horizontal"/>
                </DockPanel>
                <Border Margin="150,0,11,8" Background="#10FFFFFF" CornerRadius="4"
                        HorizontalAlignment="Left">
                    <Canvas x:Name="GraphCanvas" Height="120" ClipToBounds="True"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="LanesHost"/>
        </ScrollViewer>
    </DockPanel>
</Window>
