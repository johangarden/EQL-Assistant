<Window x:Class="EQLOverlay.Views.LevelUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- "New at this level" (owner pick, 8 Sep; Companion's level-up card):
         a dismissable card at the top of the screen listing the spells your
         combo just unlocked. Fades on its own; a click pins it. -->
    <Border x:Name="RootBorder" CornerRadius="8" Padding="14,10,14,12" Background="#E6141A24"
            BorderBrush="#E8C15A" BorderThickness="1" MaxWidth="420" MouseLeftButtonDown="Card_Click">
        <StackPanel>
            <DockPanel>
                <Border DockPanel.Dock="Right" x:Name="CloseBtn" Padding="6,1" CornerRadius="9" Cursor="Hand"
                        Background="#232B3D" BorderBrush="#3A4560" BorderThickness="1" VerticalAlignment="Top"
                        MouseLeftButtonDown="Close_Click" ToolTip="Dismiss">
                    <TextBlock Text="Got it" Foreground="#C9D4E3" FontSize="10.5" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="TitleText" Foreground="#E8C15A" FontWeight="Bold" FontSize="16"/>
            </DockPanel>
            <TextBlock x:Name="SubText" Foreground="#9FB4D0" FontSize="11" Margin="0,2,0,6" TextWrapping="Wrap"/>
            <StackPanel x:Name="Rows"/>
            <TextBlock x:Name="FootText" Foreground="#5C6B82" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
