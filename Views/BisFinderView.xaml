<UserControl x:Class="EQLOverlay.Views.BisFinderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Class combo -->
                <Border Grid.Column="0" Background="#171C2A" BorderBrush="#1F2637" BorderThickness="1"
                        CornerRadius="6" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="CLASS COMBO · PICK UP TO 3" Foreground="#5C6B82" FontSize="9.5"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <!-- A fixed 4×4 grid (owner ruling): the chips never reflow. -->
                        <UniformGrid x:Name="ClassChips" Columns="4" Rows="4" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ClassHint" Foreground="#5C6B82" FontSize="10.5" Margin="0,5,0,0"
                                   TextWrapping="Wrap" MaxWidth="252" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Priorities -->
                <Border Grid.Column="2" Background="#171C2A" BorderBrush="#1F2637" BorderThickness="1"
                        CornerRadius="6" Padding="10,8">
                    <StackPanel>
                        <TextBlock x:Name="PrioTitle" Text="PRIORITIES · WEIGHTED 2 · 1.5 · 1" Foreground="#5C6B82" FontSize="9.5"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <!-- Armor | Weapons (+ the fighting style) live with the
                             stats they change — each view keeps its own priorities. -->
                        <WrapPanel x:Name="ViewPills" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="W1" Tag="0" Cursor="Hand" MouseLeftButtonDown="Weight_Click" Background="#1B2130" BorderBrush="#3A4560" BorderThickness="1"
                                    CornerRadius="9" Padding="6,1,6,2" Margin="0,0,5,0" VerticalAlignment="Center"
                                    ToolTip="How much this pick weighs — click to cycle ×1 → ×1.5 → ×2 → ×3 (remembered for this character)">
                                <TextBlock Foreground="#E8C15A" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <ComboBox x:Name="P1" Width="118" MinHeight="28" SelectionChanged="Prio_Changed" Margin="0,0,8,0"/>
                            <Border x:Name="W2" Tag="1" Cursor="Hand" MouseLeftButtonDown="Weight_Click" Background="#1B2130" BorderBrush="#3A4560" BorderThickness="1"
                                    CornerRadius="9" Padding="6,1,6,2" Margin="0,0,5,0" VerticalAlignment="Center"
                                    ToolTip="How much this pick weighs — click to cycle ×1 → ×1.5 → ×2 → ×3 (remembered for this character)">
                                <TextBlock Foreground="#E8C15A" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <ComboBox x:Name="P2" Width="118" MinHeight="28" SelectionChanged="Prio_Changed" Margin="0,0,8,0"/>
                            <Border x:Name="W3" Tag="2" Cursor="Hand" MouseLeftButtonDown="Weight_Click" Background="#1B2130" BorderBrush="#3A4560" BorderThickness="1"
                                    CornerRadius="9" Padding="6,1,6,2" Margin="0,0,5,0" VerticalAlignment="Center"
                                    ToolTip="How much this pick weighs — click to cycle ×1 → ×1.5 → ×2 → ×3 (remembered for this character)">
                                <TextBlock Foreground="#E8C15A" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <ComboBox x:Name="P3" Width="118" MinHeight="28" SelectionChanged="Prio_Changed"/>
                        </StackPanel>
                        <!-- Armor only: the other-stats tail, under the three picks it tops up. -->
                        <WrapPanel x:Name="TailPills" Margin="0,6,0,0"/>
                        <TextBlock x:Name="ScoreNote" Foreground="#5C6B82" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Text="Score = 2·p1 + 1.5·p2 + 1·p3 on tier-scaled values."/>
                    </StackPanel>
                </Border>

            </Grid>

            <StackPanel x:Name="Verdicts" Margin="2,0,0,8"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="Board" VerticalAlignment="Top"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
