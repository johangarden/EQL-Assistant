<Window x:Class="EQLOverlay.Views.FlashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Flash"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <TextBlock x:Name="FlashText"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,-140,0,0"
                   FontSize="54" FontWeight="Bold"
                   Foreground="#FFCC33" Opacity="0"
                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="1000">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="10" Color="Black" Opacity="1"/>
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
