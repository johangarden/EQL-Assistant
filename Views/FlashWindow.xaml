<Window x:Class="EQLOverlay.Views.FlashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Flash"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="Height"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="RootBorder" CornerRadius="6" Padding="6" Background="Transparent">
        <StackPanel>
            <!-- Drag handle + title, shown only when unlocked. -->
            <Border x:Name="Header" Background="#E01B2130" CornerRadius="5" Padding="8,3" Margin="0,0,0,4"
                    Visibility="Collapsed" MouseLeftButtonDown="Header_DragMove">
                <TextBlock Text="Flash alerts" Foreground="#9FB4D0" FontWeight="Bold" FontSize="11"/>
            </Border>

            <Grid x:Name="Area">
                <!-- Preview so the area is visible while placing it (unlocked only). -->
                <TextBlock x:Name="Placeholder" Text="Flash alerts appear here"
                           Foreground="#50FFCC33" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>

                <TextBlock x:Name="FlashText" Text="" Opacity="0" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.95" Color="Black"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </StackPanel>
    </Border>
</Window>
