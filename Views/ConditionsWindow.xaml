<Window x:Class="EQLOverlay.Views.ConditionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="RootBorder" CornerRadius="6" Padding="6" Background="Transparent">
        <StackPanel>
            <!-- Drag handle + title, shown only when unlocked. -->
            <Border x:Name="Header" Background="#E01B2130" CornerRadius="5" Padding="8,3" Margin="0,0,0,4"
                    Visibility="Collapsed" MouseLeftButtonDown="Header_DragMove">
                <TextBlock Text="Conditions — stun / fear / charm / mez" Foreground="#9FB4D0"
                           FontWeight="Bold" FontSize="11"/>
            </Border>

            <TextBlock x:Name="Placeholder" Foreground="#7F93AD" FontSize="11" Margin="2,2,2,4"
                       Visibility="Collapsed" MaxWidth="220" TextWrapping="Wrap"
                       Text="A big badge appears here while you are stunned, feared, charmed or mesmerized — for as long as it lasts."/>

            <ItemsControl x:Name="BadgesControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="96" CornerRadius="12" Background="#D6141A24"
                                BorderBrush="{Binding Stroke}" BorderThickness="2"
                                Padding="6,8" Margin="3,0">
                            <StackPanel>
                                <Path Data="{Binding Glyph}" Fill="{Binding Stroke}"
                                      Width="52" Height="52" Stretch="Uniform"
                                      HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Kind}" Foreground="{Binding Stroke}"
                                           FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding Elapsed}" Foreground="#C9D4E3"
                                           FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
