<Window x:Class="EQLOverlay.Views.SkyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Quests"
        Width="760" Height="640"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <!-- Title → Menu → Pills (owner ruling, 4 Sep): the menu row is
                 the quest PACKS — Epics join as they're built. -->
            <DockPanel>
                <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Foreground="{StaticResource Brush.Gold}"
                           FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="Quests" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <StackPanel x:Name="MenuRow" Margin="0,4,0,8"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                       Text="Click a class badge to see its quests — the ring fills as they complete. Turn-in items are counted from your loot history (kept items and currency pickups like wind runes); a quest checks itself off when you COMPLETE the trade with its turn-in NPC (offers alone can still be cancelled), or tick it yourself."/>

            <!-- Class badges: monogram ring + completion arc; click filters. -->
            <ItemsControl x:Name="BadgesControl" Margin="0,2,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Padding="5,4" Margin="0,0,3,3" Cursor="Hand"
                                Background="{Binding SelBg}" Tag="{Binding}"
                                MouseLeftButtonUp="Badge_Click" ToolTip="{Binding Tip}">
                            <StackPanel Width="46">
                                <TextBlock Text="{Binding TopLabel}" Foreground="#7F93AD" FontSize="9.5"
                                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <Grid Width="38" Height="38" HorizontalAlignment="Center">
                                    <Ellipse Stroke="#2A3347" StrokeThickness="3"/>
                                    <Path Data="{Binding Arc}" Stroke="{Binding Ring}"
                                          StrokeThickness="3" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Path Data="{Binding Glyph}" Fill="{Binding Ink}"
                                          Width="20" Height="20" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Abbr}" Foreground="{Binding Ink}"
                                               FontSize="10.5" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding AbbrVisibility}"/>
                                    <TextBlock Text="✓" Foreground="#81C784" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Margin="0,0,-2,-4" Visibility="{Binding DoneVisibility}"/>
                                </Grid>
                                <TextBlock Text="{Binding CountText}" Foreground="#7F93AD" FontSize="9.5"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- VIEW pills — what the window IS showing; the filters below
                 belong to the Quests view (search also serves the isle list). -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border x:Name="QuestsPill" CornerRadius="14" BorderThickness="1" Padding="15,4"
                        Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="View_Click" Tag="quests">
                    <TextBlock Text="Quests" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="IslePill" CornerRadius="14" BorderThickness="1" Padding="15,4"
                        Cursor="Hand" Margin="0,0,6,0" MouseLeftButtonDown="View_Click" Tag="isle"
                        ToolTip="The shopping list — everything active quests still need, grouped by the isle it drops on">
                    <TextBlock Text="Needed by isle" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
                <Border x:Name="HousePill" CornerRadius="14" BorderThickness="1" Padding="15,4"
                        Cursor="Hand" MouseLeftButtonDown="View_Click" Tag="house"
                        ToolTip="Spare copies no active quest still needs — safe to hand to a guildie">
                    <TextBlock Text="Quest item housekeeping" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>

            <DockPanel x:Name="FiltersRow" Margin="0,0,0,8">
                <ComboBox x:Name="SlotBox" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                          SelectionChanged="Filters_Changed"/>
                <ComboBox x:Name="StatusBox" DockPanel.Dock="Right" Width="140" Margin="8,0,0,0"
                          SelectedValuePath="Tag" SelectedIndex="0"
                          SelectionChanged="Filters_Changed">
                    <ComboBoxItem Content="Ready to turn in" Tag="ready"/>
                    <ComboBoxItem Content="Active (not done)" Tag="active"/>
                    <ComboBoxItem Content="All" Tag="all"/>
                    <ComboBoxItem Content="Partly done" Tag="partly"/>
                    <ComboBoxItem Content="Done" Tag="done"/>
                </ComboBox>
                <TextBox x:Name="SearchBox" TextChanged="Filters_Changed"
                         AutomationProperties.AutomationId="SkySearchBox"
                         ToolTip="Search quest, reward or item"/>
            </DockPanel>
        </StackPanel>

        <Grid>
        <ScrollViewer x:Name="QuestsScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="QuestsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                Opacity="{Binding CardOpacity}">
                            <StackPanel>
                                <DockPanel>
                                    <!-- ★ leads the card — tracking is the everyday act: the
                                         quest stands in the helper panel's Hunting list until
                                         completed (which un-tracks it). -->
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding TrackText}"
                                               Foreground="{Binding TrackFg}" FontSize="17" Cursor="Hand"
                                               VerticalAlignment="Center" Margin="0,0,9,0"
                                               ToolTip="Track this hunt — its missing items and their droppers stand on the Sky helper panel"
                                               MouseLeftButtonUp="Track_Click"/>
                                    <!-- The manual done-check retires to the far right (rare,
                                         confirmed) — the reward line normally checks it itself. -->
                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Done, Mode=OneWay}"
                                              Checked="Done_Checked" Unchecked="Done_Unchecked"
                                              VerticalAlignment="Center" Margin="10,0,0,0"
                                              ToolTip="Mark complete (auto-checks when the reward appears in the log)"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"
                                               Foreground="{Binding ProgressBrush}" FontWeight="Bold"
                                               FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.TextDim}"
                                                   FontWeight="Bold" FontSize="13"/>
                                        <Border CornerRadius="3" Background="{StaticResource Brush.Card}"
                                                Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding SlotVisibility}">
                                            <TextBlock Text="{Binding Slot}" Foreground="{StaticResource Brush.TextBlue}"
                                                       FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <!-- the reward item on its own line, then the drops
                                     stacked, then who takes the turn-in -->
                                <StackPanel Orientation="Horizontal" Margin="24,2,0,0"
                                            ToolTip="{Binding RewardStats}">
                                    <Image Source="{Binding RewardIcon}" Width="18" Height="18"
                                           Margin="0,0,6,0" VerticalAlignment="Center"
                                           Visibility="{Binding RewardIconVis}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Reward}" Foreground="{StaticResource Brush.Gold}"
                                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Chips}" Margin="24,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Background="{Binding Bg}" Padding="7,2"
                                                    Margin="0,1,0,1" ToolTip="{Binding Tip}" Cursor="Hand"
                                                    HorizontalAlignment="Left"
                                                    MouseLeftButtonUp="Chip_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{Binding Fg}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               TextDecorations="Underline"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CountText}" Foreground="{Binding Fg}"
                                                               FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                                    <TextBlock Text="{Binding Sub}" Foreground="{Binding Fg}"
                                                               Opacity="0.72" FontSize="10.5" Margin="10,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Brush.TextHint}"
                                           FontSize="11" Margin="24,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Needed by isle: the shopping list, one section per island. -->
        <ScrollViewer x:Name="IsleScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <ItemsControl x:Name="IsleControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                        MouseLeftButtonDown="Isle_Toggle" Tag="{Binding Isle}"
                                        Margin="0,0,0,4">
                                <TextBlock Text="{Binding Arrow}" Foreground="{StaticResource Brush.Gold}"
                                           FontSize="11" Margin="0,2,6,0"/>
                                <TextBlock Text="{Binding Isle}" Foreground="{StaticResource Brush.Gold}"
                                           FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="{Binding NeedText}" Foreground="#FF8A80"
                                           FontWeight="SemiBold" FontSize="11.5"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Rows}" Visibility="{Binding RowsVisibility}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Padding="9,5" CornerRadius="5"
                                                Background="{StaticResource Brush.Surface}"
                                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Main}"
                                                               Foreground="{StaticResource Brush.TextDim}"
                                                               FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{Binding Count}" Foreground="#FF8A80"
                                                               FontWeight="Bold" FontSize="12" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Sub}"
                                                           Foreground="{StaticResource Brush.TextHint}"
                                                           FontSize="10.5" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Housekeeping: spare copies nothing active still wants. -->
        <ScrollViewer x:Name="HouseScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="HouseHint" Foreground="{StaticResource Brush.TextHint}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Per the loot ledger (looted minus turned in): spare copies no ACTIVE quest still needs — every quest wanting them is done, or you hold extras. Safe to hand to a guildie or clear out."/>
                <ItemsControl x:Name="HouseControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="9,5" CornerRadius="5"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent"
                                                MouseLeftButtonDown="House_Toggle" Tag="{Binding Main}">
                                        <TextBlock Text="{Binding Arrow}" Foreground="{StaticResource Brush.Gold}"
                                                   FontSize="11" Margin="0,1,6,0"/>
                                        <TextBlock Text="{Binding Main}" Foreground="{StaticResource Brush.TextDim}"
                                                   FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{Binding Count}" Foreground="#81C784"
                                                   FontWeight="Bold" FontSize="12" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Locations}"
                                                  Visibility="{Binding RowsVisibility}"
                                                  Margin="17,4,0,1">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{StaticResource Brush.TextHint}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
