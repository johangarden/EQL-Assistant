<Window x:Class="EQLOverlay.Views.SkyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQL Assistant — Plane of Sky"
        Width="760" Height="640"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Icon="/assets/eqloverlay.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock x:Name="SummaryText" DockPanel.Dock="Right" Foreground="{StaticResource Brush.Gold}"
                           FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="Plane of Sky — Test quests" Style="{StaticResource PageTitle}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                       Text="Click a class badge to see its quests — the ring fills as they complete. Turn-in items are counted from your loot history (kept items only); a quest checks itself off when its reward shows up in the log, or tick it yourself."/>

            <!-- Class badges: monogram ring + completion arc; click filters. -->
            <ItemsControl x:Name="BadgesControl" Margin="0,2,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Padding="5,4" Margin="0,0,3,3" Cursor="Hand"
                                Background="{Binding SelBg}" Tag="{Binding}"
                                MouseLeftButtonUp="Badge_Click" ToolTip="{Binding Tip}">
                            <StackPanel Width="46">
                                <TextBlock Text="{Binding TopLabel}" Foreground="#7F93AD" FontSize="9.5"
                                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <Grid Width="38" Height="38" HorizontalAlignment="Center">
                                    <Ellipse Stroke="#2A3347" StrokeThickness="3"/>
                                    <Path Data="{Binding Arc}" Stroke="{Binding Ring}"
                                          StrokeThickness="3" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                    <Path Data="{Binding Glyph}" Fill="{Binding Ink}"
                                          Width="20" Height="20" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Abbr}" Foreground="{Binding Ink}"
                                               FontSize="10.5" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding AbbrVisibility}"/>
                                    <TextBlock Text="✓" Foreground="#81C784" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Margin="0,0,-2,-4" Visibility="{Binding DoneVisibility}"/>
                                </Grid>
                                <TextBlock Text="{Binding CountText}" Foreground="#7F93AD" FontSize="9.5"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,0,0,8">
                <ComboBox x:Name="SlotBox" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                          SelectionChanged="Filters_Changed"/>
                <CheckBox x:Name="HideDoneCheck" DockPanel.Dock="Right" Content="Hide completed"
                          IsChecked="True"
                          Margin="8,0,0,0" VerticalAlignment="Center" Checked="Filters_Changed"
                          Unchecked="Filters_Changed"/>
                <TextBox x:Name="SearchBox" TextChanged="Filters_Changed"
                         AutomationProperties.AutomationId="SkySearchBox"
                         ToolTip="Search quest, reward or item"/>
            </DockPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="QuestsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                Opacity="{Binding CardOpacity}">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Done, Mode=OneWay}"
                                              Checked="Done_Checked" Unchecked="Done_Unchecked"
                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                              ToolTip="Mark complete (auto-checks when the reward appears in the log)"/>
                                    <!-- ★ = tracked: the quest stands in the helper panel's
                                         Hunting list until completed (which un-tracks it). -->
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TrackText}"
                                               Foreground="{Binding TrackFg}" FontSize="14" Cursor="Hand"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               Visibility="{Binding TrackVisibility}"
                                               ToolTip="Track this hunt — its missing items and their droppers stand on the Sky helper panel"
                                               MouseLeftButtonUp="Track_Click"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"
                                               Foreground="{Binding ProgressBrush}" FontWeight="Bold"
                                               FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource Brush.TextDim}"
                                                   FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Reward}" Foreground="{StaticResource Brush.Gold}"
                                                   FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0"
                                                   ToolTip="{Binding RewardStats}"/>
                                        <Border CornerRadius="3" Background="{StaticResource Brush.Card}"
                                                Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding SlotVisibility}">
                                            <TextBlock Text="{Binding Slot}" Foreground="{StaticResource Brush.TextBlue}"
                                                       FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Brush.TextHint}"
                                           FontSize="11" Margin="24,1,0,4"/>
                                <ItemsControl ItemsSource="{Binding Chips}" Margin="24,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Background="{Binding Bg}" Padding="7,2"
                                                    Margin="0,2,6,2" ToolTip="{Binding Tip}">
                                                <TextBlock Text="{Binding Text}" Foreground="{Binding Fg}"
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
