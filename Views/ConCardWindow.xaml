<Window x:Class="EQLOverlay.Views.ConCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- The con card (owner pick, 8 Sep; Companion's con tooltip): /con a mob
         and what it shrugs off, from your own resist history, appears at the
         top of the screen for a few seconds. Never takes focus. -->
    <Border x:Name="RootBorder" CornerRadius="8" Padding="12,8,12,10" Background="#E6141A24"
            BorderBrush="#9575CD" BorderThickness="1" MaxWidth="440" MouseLeftButtonDown="Card_Click">
        <StackPanel>
            <DockPanel>
                <Border DockPanel.Dock="Right" Padding="6,1" CornerRadius="9" Cursor="Hand"
                        Background="#232B3D" BorderBrush="#3A4560" BorderThickness="1" VerticalAlignment="Top"
                        MouseLeftButtonDown="Close_Click" ToolTip="Dismiss">
                    <TextBlock Text="✕" Foreground="#C9D4E3" FontSize="10.5" FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="TitleText" Foreground="#E6ECF5" FontWeight="Bold" FontSize="13.5"/>
            </DockPanel>
            <StackPanel x:Name="Rows" Margin="0,4,0,0"/>
            <TextBlock x:Name="FootText" Foreground="#5C6B82" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
