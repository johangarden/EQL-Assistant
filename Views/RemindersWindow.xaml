<Window x:Class="EQLOverlay.Views.RemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border x:Name="RootBorder" CornerRadius="6" Padding="6" Background="Transparent">
        <StackPanel>
            <!-- Drag handle + title, shown only when unlocked. -->
            <Border x:Name="Header" Background="#E01B2130" CornerRadius="5" Padding="8,3" Margin="0,0,0,4"
                    Visibility="Collapsed" MouseLeftButtonDown="Header_DragMove">
                <TextBlock Text="Rebuff reminders" Foreground="#9FB4D0" FontWeight="Bold" FontSize="11"/>
            </Border>

            <TextBlock x:Name="Placeholder" Foreground="#7F93AD" FontSize="11" Margin="2,2,2,4"
                       Visibility="Collapsed"
                       Text="Buffs marked 'Remind me when missing' nag here once they drop."/>

            <ItemsControl x:Name="RowsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,1" CornerRadius="4" Background="#C0301316" Padding="8,4"
                                BorderBrush="#7A2E33" BorderThickness="1" MinWidth="200">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="REBUFF" Foreground="#FF8A80"
                                           FontWeight="Bold" FontSize="11" VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12"
                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
