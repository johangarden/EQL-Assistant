<UserControl x:Class="EQLOverlay.Views.SpellLibraryPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource Brush.Window}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- The spell library's content (29 Sep): hosted by the trigger editor's
         Library window (Durations) and the Tools window (Efficiency · Invocations). -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#7F93AD" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock x:Name="HeadingText" Text="Spell library" FontSize="16" FontWeight="Bold" Foreground="White"/>
            </DockPanel>
            <!-- DURATIONS | EFFICIENCY (owner, 25 Sep: damage / heal per mana, at your rank, yours) -->
            <StackPanel x:Name="TabRow" Orientation="Horizontal" Margin="0,6,0,6"/>
            <TextBlock x:Name="DurHint" Foreground="#7F93AD" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"
                       Text="Every spell the duration learner has measured — the estimate the bars use (log = learned from your own cast→fade cycles, db = the library's figure), sample count and spread. Search reaches the WHOLE ~1400-spell library; ＋ Me adds a ready-made countdown bar trigger (type, color, duration and fade voice prefilled) to the current loadout, ＋ Pet tracks the buff on your pet instead."/>

            <DockPanel x:Name="SearchRow" Margin="0,0,0,8">
                <ComboBox x:Name="ClassBox" DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                          MinHeight="30" SelectionChanged="Filters_Changed"/>
                <TextBox x:Name="SearchBox" TextChanged="Filters_Changed"
                         AutomationProperties.AutomationId="LibrarySearchBox"
                         ToolTip="Search the whole spell library by name, landing line or effect (dd, dot, hot, mez, slow, ds…) — matches without samples show with the library's duration"/>
            </DockPanel>
            <TextBlock x:Name="EffWho" Visibility="Collapsed" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <WrapPanel x:Name="EffBar" Visibility="Collapsed" Margin="0,0,0,8"/>
            <UniformGrid x:Name="EffVerdicts" Visibility="Collapsed" Rows="1" Margin="0,0,0,8"/>
        </StackPanel>

        <TextBlock x:Name="EffFoot" DockPanel.Dock="Bottom" Visibility="Collapsed" Foreground="#5C6B82" FontSize="10.5"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>
        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid>
                <Grid x:Name="DurTableHost" VerticalAlignment="Top"/>
                <Grid x:Name="EffTableHost" VerticalAlignment="Top" Visibility="Collapsed"/>
                <!-- INVOCATIONS (owner, 29 Sep): a real stretch of your log replayed under each invocation -->
                <StackPanel x:Name="InvHost" VerticalAlignment="Top" Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
