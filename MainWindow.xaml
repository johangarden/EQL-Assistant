<Window x:Class="EQLOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EQLOverlay.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="EQL Assistant"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Group the bars by their Category so we can show headers. -->
        <CollectionViewSource x:Key="GroupedBars" Source="{Binding Bars}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One countdown bar. -->
        <DataTemplate x:Key="BarTemplate" DataType="{x:Type vm:TimerBarViewModel}">
            <Grid Height="{Binding DataContext.BarHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                  Margin="{Binding DataContext.Spacing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BottomSpacing}}">
                <!-- track -->
                <Border CornerRadius="4" Background="#C8101318"/>
                <!-- depleting fill (width scales with Fraction via a nested grid) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FillStar}}"/>
                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource RestStar}}"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="4" Background="{Binding Fill}" Opacity="0.85"/>
                </Grid>
                <!-- subtle border -->
                <Border CornerRadius="4" BorderBrush="#40FFFFFF" BorderThickness="1"/>
                <!-- labels -->
                <Grid Margin="8,0">
                    <TextBlock Text="{Binding Name}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Foreground="White"
                               FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding RemainingText}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Foreground="White"
                               FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontWeight="Bold">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.9" Color="Black"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
                <!-- warning pulse overlay -->
                <Border x:Name="WarnGlow" CornerRadius="4" Background="#00FF3B30" IsHitTestVisible="False"/>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="PulseSb">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="WarnGlow"
                                                 Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Opacity)"
                                                 From="0.0" To="0.45" Duration="0:0:0.5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PulseSb"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- Root card. When locked, background is fully transparent (nothing but bars). -->
    <Border x:Name="RootBorder"
            CornerRadius="6"
            Padding="6">
        <StackPanel x:Name="SizerHost" Width="320">

            <!-- Toolbar: only when unlocked. Also the drag handle. -->
            <Border x:Name="Toolbar"
                    Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}"
                    Background="#E01B2130" CornerRadius="5" Padding="8,5" Margin="0,0,0,6"
                    MouseLeftButtonDown="Toolbar_DragMove">
                <StackPanel>
                    <!-- Header: right-side controls dock first (always visible); the loadout
                         button is the fill child, so a long name just truncates into the gap
                         and can never push ✕/Manage/version/mute/lock off. -->
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Left" Content="✕" Click="OnQuit" Style="{StaticResource CloseBtn}"
                                ToolTip="Quit EQL Assistant"/>

                        <Button DockPanel.Dock="Right" Click="OnLock" Style="{StaticResource IconBtn}" Margin="6,0,0,0"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE72E;"
                                ToolTip="Lock overlay — click-through (Ctrl+Alt+L)"/>

                        <Border DockPanel.Dock="Right" Width="22" Height="22" CornerRadius="4"
                                Background="#2A3346" Margin="8,0,0,0"
                                ToolTip="Alerts muted — Ctrl+Alt+S to unmute"
                                Visibility="{Binding Muted, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="#FFB74D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Foreground="#6E7C93"
                                   FontSize="10" VerticalAlignment="Center" Margin="7,0,0,0"/>

                        <Button DockPanel.Dock="Right" Content="Manage" Click="OnManage"
                                Style="{StaticResource AccentBtn}" Margin="6,0,0,0"
                                ToolTip="Open Trigger Manager"/>

                        <!-- One menu, same as the tray: panels, histories, updates — everything. -->
                        <Button DockPanel.Dock="Right" Click="OnMainMenu" Style="{StaticResource IconBtn}"
                                Margin="6,0,0,0" FontFamily="Segoe MDL2 Assets" Content="&#xE700;"
                                AutomationProperties.AutomationId="MainMenuBtn"
                                ToolTip="Menu — panels, histories, updates (same as the tray)"/>

                        <!-- fill: loadout dropdown, truncates to fit -->
                        <Button Click="OnLoadoutMenu" Style="{StaticResource ToolBtn}"
                                Margin="8,0,0,0" HorizontalContentAlignment="Left" ToolTip="Switch loadout">
                            <TextBlock Text="{Binding LoadoutName, StringFormat='{}{0}  ▾'}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Button>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Foreground="#7F93AD"
                               FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Ctrl+Alt+ L lock · R timer · D meter · C text · T test · H hide · S mute · Q quit"
                               Foreground="#5C6B82" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- The bars, grouped by category. -->
            <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedBars}}"
                          ItemTemplate="{StaticResource BarTemplate}">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#8FA6C4" FontSize="11" FontWeight="Bold"
                                           Margin="2,2,0,3"
                                           Visibility="{Binding DataContext.ShowCategoryHeaders,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                        Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.8" Color="Black"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
