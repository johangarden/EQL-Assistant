<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         EQL Assistant design system — palette + app-wide chrome.
         Merged in App.xaml, so every window (overlay panels included)
         can reference these brushes and keyed styles.
         ============================================================ -->

    <!-- Surfaces, darkest to lightest. -->
    <SolidColorBrush x:Key="Brush.Sunken"  Color="#10151F"/> <!-- sidebar / recessed areas -->
    <SolidColorBrush x:Key="Brush.Window"  Color="#141A24"/> <!-- dialog window background -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#1B2130"/> <!-- lists, cards, popups -->
    <SolidColorBrush x:Key="Brush.Card"    Color="#20293A"/> <!-- tinted section cards -->
    <SolidColorBrush x:Key="Brush.Field"   Color="#232B3D"/> <!-- text inputs -->
    <SolidColorBrush x:Key="Brush.Control" Color="#2A3346"/> <!-- buttons at rest -->
    <SolidColorBrush x:Key="Brush.ControlHover"   Color="#3C4A63"/>
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#22608F"/>

    <!-- Lines. -->
    <SolidColorBrush x:Key="Brush.Border"      Color="#3A4560"/>
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#4A5A78"/>

    <!-- Accent (actions, selection). -->
    <SolidColorBrush x:Key="Brush.Accent"        Color="#2E6FB0"/>
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#3A82C8"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#255E96"/>
    <SolidColorBrush x:Key="Brush.AccentBorder"  Color="#57A0DE"/>

    <!-- Text, brightest to faintest. -->
    <SolidColorBrush x:Key="Brush.Text"      Color="#DCE6F5"/> <!-- body -->
    <SolidColorBrush x:Key="Brush.TextDim"   Color="#C9D4E3"/> <!-- headings, names -->
    <SolidColorBrush x:Key="Brush.TextBlue"  Color="#8FA6C4"/> <!-- secondary values -->
    <SolidColorBrush x:Key="Brush.TextHint"  Color="#7F93AD"/> <!-- hints, subtitles -->
    <SolidColorBrush x:Key="Brush.TextFaint" Color="#5C6B82"/> <!-- detail lines, micro-labels -->

    <!-- Semantics (shared with the overlay panels). -->
    <SolidColorBrush x:Key="Brush.Gold"     Color="#FFD54F"/> <!-- damage dealt / highlights -->
    <SolidColorBrush x:Key="Brush.SelfGold" Color="#FFC12E"/> <!-- "you" in rankings -->
    <SolidColorBrush x:Key="Brush.Incoming" Color="#FF8A80"/> <!-- damage taken -->
    <SolidColorBrush x:Key="Brush.Heal"     Color="#81C784"/> <!-- healing -->
    <SolidColorBrush x:Key="Brush.Success"  Color="#6FCF97"/> <!-- status "saved ✓" -->
    <SolidColorBrush x:Key="Brush.Warn"     Color="#FFB74D"/> <!-- warnings, mute badge -->

    <!-- ============================================================
         Shared keyed buttons (overlay toolbar + dialogs).
         ============================================================ -->

    <!-- Red window-style close button (top-left quit). -->
    <Style x:Key="CloseBtn" TargetType="Button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="Background" Value="#33202A"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="4"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C50F1F"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent button (Manage) — blue, stands out a little. -->
    <Style x:Key="AccentBtn" TargetType="Button">
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="3"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.AccentPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square icon button (padlock, meter tools). -->
    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Control}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="4" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.ControlHover}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#22608FCC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolBtn" TargetType="Button">
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Control}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderHover}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="3"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Brush.ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#22608FCC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         App-wide chrome: tooltips and context menus.
         (These pop up from overlay panels too, so they live here.)
         ============================================================ -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.BorderHover}" BorderThickness="1"
                            CornerRadius="5" Padding="9,6" MaxWidth="360">
                        <Border.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </Border.Resources>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.BorderHover}" BorderThickness="1"
                            CornerRadius="6" Padding="4">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat menu item with a check glyph column. Our menus are one level
         deep (loadout picker, timer presets) — no submenu support needed. -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" CornerRadius="4" Padding="8,6" Background="Transparent">
                        <DockPanel>
                            <Path x:Name="check" DockPanel.Dock="Left" Width="14" Margin="0,0,6,0"
                                  Data="M0,4 L3.5,7.5 9,0" Stroke="{StaticResource Brush.AccentBorder}"
                                  StrokeThickness="1.8" VerticalAlignment="Center" Visibility="Hidden"/>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.ControlHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="6,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
